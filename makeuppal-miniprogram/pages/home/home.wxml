<!--pages/home/home.wxml-->
<view class="page-container home-page">

  <!-- 面部档案卡片（紧凑版） -->
  <view class="face-profile-compact" bindtap="onFaceProfileTap" wx:if="{{faceProfile}}">
    <image-safe src="{{faceProfile.avatar}}" class="face-slim-avatar" mode="aspectFill" />
    <view class="face-slim-info">
      <view class="face-slim-title">
        <text class="face-slim-name">{{faceProfile.name}} · 面部档案</text>
        <text class="face-slim-score">骨相 {{faceProfile.boneScore}}分</text>
      </view>
      <view class="face-slim-detail">
        <text>{{faceProfile.faceShape}}</text><text class="dot">·</text>
        <text>{{faceProfile.skinType}}</text><text class="dot">·</text>
        <text>{{faceProfile.undertone}}</text>
      </view>
      <view class="face-slim-tags">
        <text class="face-slim-tag" wx:for="{{faceProfile.traits}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <view class="face-slim-arrow">
      <text class="icon-arrow-right">›</text>
    </view>
  </view>

  <!-- 美妆闺蜜问候卡 -->
  <view class="companion-greeting" bindtap="onCompanionTap">
    <image-safe src="coverCreator7" class="companion-greeting-avatar" mode="aspectFill" />
    <view class="companion-greeting-content">
      <view class="companion-greeting-title">🌸 小美说...</view>
      <view class="companion-greeting-text">今天天气好适合出门呀！我帮你搭了个温柔日常妆，要不要看看？</view>
      <view class="companion-greeting-action">
        <text class="companion-greeting-btn">聊聊看 →</text>
      </view>
    </view>
  </view>

  <!-- 金刚位 5宫格 -->
  <view class="kingkong-grid">
    <view class="kingkong-item" bindtap="onKingKongTap" data-key="mirror">
      <view class="kingkong-icon mirror">🪞</view>
      <text class="kingkong-label">美妆魔镜</text>
    </view>
    <view class="kingkong-item" bindtap="onKingKongTap" data-key="library">
      <view class="kingkong-icon library">🔍</view>
      <text class="kingkong-label">局部搜索</text>
    </view>
    <view class="kingkong-item" bindtap="onKingKongTap" data-key="mall">
      <view class="kingkong-icon mall">🛍️</view>
      <text class="kingkong-label">美妆市集</text>
    </view>
    <view class="kingkong-item" bindtap="onKingKongTap" data-key="scan">
      <view class="kingkong-icon scan new">🔬</view>
      <text class="kingkong-label">成分扫描</text>
    </view>
    <view class="kingkong-item" bindtap="onKingKongTap" data-key="creator">
      <view class="kingkong-icon creator">✨</view>
      <text class="kingkong-label">创作者</text>
    </view>
  </view>

  <!-- Banner 轮播 -->
  <swiper class="hero-banner" autoplay="{{true}}" interval="4000" duration="500" circular="{{true}}" bindchange="onBannerChange">
    <swiper-item wx:for="{{bannerList}}" wx:key="id">
      <view class="hero-slide" bindtap="onBannerTap" data-action="{{item.action}}">
        <image-safe src="{{item.img}}" class="hero-slide-img" mode="aspectFill" />
        <view class="hero-gradient"></view>
        <view class="hero-content">
          <view class="hero-badge {{item.badgeClass}}">{{item.badge}}</view>
          <text class="hero-title">{{item.title}}</text>
          <text class="hero-desc">{{item.desc}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 本周热度榜 -->
  <view class="trending-section">
    <view class="section-header">
      <text class="section-title">🔥 本周热度榜</text>
      <text class="section-more" bindtap="onMoreTrending">更多 →</text>
    </view>
    <scroll-view class="trending-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="trending-card" wx:for="{{trendingList}}" wx:key="id" bindtap="onTrendingTap" data-id="{{item.id}}">
        <view class="trending-card-img">
          <image-safe src="{{item.img}}" class="trending-img" mode="aspectFill" />
          <view class="trending-rank rank-{{item.rank}}" wx:if="{{item.rank <= 3}}">{{item.rank}}</view>
          <view class="trending-rank" wx:else>{{item.rank}}</view>
        </view>
        <view class="trending-card-info">
          <text class="trending-card-name">{{item.name}}</text>
          <view class="trending-card-meta">
            <text class="trending-card-author">{{item.author}}</text>
            <text class="trending-card-price">{{item.price}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 瀑布流：大家都在看 -->
  <view class="waterfall-section">
    <view class="section-header">
      <text class="section-title">✨ 大家都在看</text>
    </view>
    <view class="waterfall-grid">
      <view class="waterfall-column">
        <view class="waterfall-card" wx:for="{{waterfallList}}" wx:key="id" wx:if="{{index % 2 === 0}}" bindtap="onWaterfallTap" data-id="{{item.id}}">
          <view class="waterfall-card-img" style="height: {{item.height}}px;">
            <image-safe src="{{item.img}}" class="waterfall-img" mode="aspectFill" />
            <text class="waterfall-badge {{item.badgeClass}}">{{item.badge}}</text>
          </view>
          <view class="waterfall-card-info">
            <text class="waterfall-card-title">{{item.title}}</text>
            <view class="waterfall-card-bottom">
              <view class="waterfall-card-creator">
                <view class="waterfall-creator-avatar" style="background: {{item.avatarBg}};">{{item.avatarText}}</view>
                <text class="waterfall-creator-name">{{item.creator}}</text>
              </view>
              <text class="waterfall-card-price">{{item.price}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="waterfall-column">
        <view class="waterfall-card" wx:for="{{waterfallList}}" wx:key="id" wx:if="{{index % 2 === 1}}" bindtap="onWaterfallTap" data-id="{{item.id}}">
          <view class="waterfall-card-img" style="height: {{item.height}}px;">
            <image-safe src="{{item.img}}" class="waterfall-img" mode="aspectFill" />
            <text class="waterfall-badge {{item.badgeClass}}">{{item.badge}}</text>
          </view>
          <view class="waterfall-card-info">
            <text class="waterfall-card-title">{{item.title}}</text>
            <view class="waterfall-card-bottom">
              <view class="waterfall-card-creator">
                <view class="waterfall-creator-avatar" style="background: {{item.avatarBg}};">{{item.avatarText}}</view>
                <text class="waterfall-creator-name">{{item.creator}}</text>
              </view>
              <text class="waterfall-card-price">{{item.price}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 40px;"></view>

  <!-- 美妆闺蜜浮动按钮 -->
  <companion-fab bind:tap="onCompanionFabTap" />
</view>
