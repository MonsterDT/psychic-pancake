/* pages/mall/mall.wxss - 市集页样式 */

.mall-page {
  padding: 0;
  padding-bottom: calc(var(--tab-bar-height) + var(--safe-bottom) + 20px);
  background: var(--color-bg);
  min-height: 100vh;
}

/* ===== 顶部搜索栏 ===== */
.mall-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: var(--color-bg);
  box-shadow: 0 1px 2px rgba(45, 42, 38, 0.04);
}

.mall-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  padding: 8px 16px;
  box-shadow: var(--shadow-xs);
}

.mall-search-box .search-icon {
  font-size: 14px;
  flex-shrink: 0;
}

.mall-search-box .search-input {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text);
  background: transparent;
}

.header-right {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.icon-btn {
  position: relative;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-xs);
}

.icon-btn .icon-emoji {
  font-size: 18px;
}

.icon-btn.btn-hover {
  background: var(--color-bg-alt);
}

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: var(--radius-full);
  background: var(--color-danger);
  color: #FFF8F0;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--color-bg);
}

/* ===== 分类 tab ===== */
.mall-tabs {
  position: sticky;
  top: 60px;
  z-index: 15;
  white-space: nowrap;
  padding: 10px 16px;
  background: var(--color-bg);
}

.mall-tab {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 8px 16px;
  margin-right: 8px;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  transition: all var(--duration-fast) var(--ease);
}

.mall-tab .tab-icon {
  font-size: 14px;
}

.mall-tab.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #FFF8F0;
  font-weight: var(--font-weight-semibold);
  box-shadow: 0 2px 6px rgba(196, 149, 106, 0.3);
}

.mall-tab.tab-hover {
  background: var(--color-bg-alt);
}

/* ===== 子分类 ===== */
.mall-sub-tabs {
  white-space: nowrap;
  padding: 0 16px 12px;
}

.mall-sub-tab {
  display: inline-block;
  padding: 6px 14px;
  margin-right: 8px;
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
  transition: all var(--duration-fast) var(--ease);
}

.mall-sub-tab.active {
  background: var(--color-bg-alt);
  color: var(--color-primary-dark);
  font-weight: var(--font-weight-medium);
}

.mall-sub-tab.subtab-hover {
  background: var(--color-border-light);
}

/* ===== 品牌官方 ===== */
.brand-strip {
  padding: 8px 16px 16px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.section-header-product {
  padding: 0 16px;
  margin-top: 8px;
}

.section-title-sm {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.section-more {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

.product-count {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.brand-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 14px;
  margin-bottom: 10px;
  box-shadow: var(--shadow-sm);
}

.brand-card.card-hover {
  background: var(--color-bg-alt);
}

.brand-logo {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF8F0;
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}

.logo-ysl {
  background: linear-gradient(135deg, #1A1816, #4A3F36);
}

.logo-lancome {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
}

.brand-info {
  flex: 1;
}

.brand-name-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 4px;
}

.brand-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.verified {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  background: var(--color-bg-alt);
  padding: 2px 6px;
  border-radius: var(--radius-xs);
}

.brand-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.brand-btn {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  color: var(--color-primary-dark);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  flex-shrink: 0;
}

.brand-btn.btn-hover {
  background: var(--color-border);
}

/* ===== 商品网格 ===== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 8px 16px;
}

/* product-card 组件占两列布局 */
.product-grid > product-card {
  width: calc((100% - 10px) / 2);
}

.bottom-spacer {
  height: 20px;
}
