<!--pages/mirror/mirror.wxml - 焕新页（AI虚拟试妆）-->
<view class="page-container mirror-page">

  <!-- 试妆主区 -->
  <view class="mirror-hero-v2">

    <!-- 设置按钮 -->
    <view class="mirror-settings-btn" bindtap="onSettingsTap" hover-class="btn-hover">
      <text class="icon-text">⚙️</text>
    </view>

    <!-- 摄像头试妆区 / 降级占位 -->
    <view class="mirror-face-area">
      <camera wx:if="{{cameraReady}}" class="mirror-camera" device-position="front" flash="off" binderror="onCameraError"></camera>
      <view wx:else class="mirror-camera-fallback">
        <image-safe src="{{faceGuideImage}}" class="mirror-fallback-img" mode="aspectFill" />
      </view>

      <!-- 人脸引导环（覆盖在摄像头上） -->
      <view class="mirror-face-ring-v2">
        <view class="mirror-face-inner">
          <text class="face-icon">😊</text>
        </view>
      </view>

      <view class="mirror-title-v2">AI 虚拟试妆</view>
      <view class="mirror-subtitle-v2">选择妆容模板，一键上脸体验</view>
      <view class="mirror-encouragement">
        <text class="encouragement-emoji">💖</text>
        <text class="encouragement-text">今天的你也很美！试试看新妆容吧</text>
      </view>

      <!-- 闺蜜引导条 -->
      <view class="mirror-companion-guide" bindtap="onCompanionGuideTap" hover-class="btn-hover">
        <view class="companion-guide-icon"><text>💬</text></view>
        <text class="companion-guide-text">有美妆问题？点击右侧浮窗召唤小美</text>
        <text class="companion-guide-arrow">›</text>
      </view>

      <!-- 进度点 -->
      <view class="mirror-progress-dots">
        <view class="dot {{currentStep >= 1 ? 'active' : ''}}"></view>
        <view class="dot {{currentStep >= 2 ? 'active' : ''}}"></view>
        <view class="dot {{currentStep >= 3 ? 'active' : ''}}"></view>
        <view class="dot {{currentStep >= 4 ? 'active' : ''}}"></view>
        <view class="dot {{currentStep >= 5 ? 'active' : ''}}"></view>
      </view>
    </view>

    <!-- 底部工具栏 -->
    <view class="mirror-bottom-bar">
      <view class="mirror-bottom-btn {{filterOn ? 'active' : ''}}" bindtap="onToggleFilter" hover-class="btn-hover">
        <text class="btn-icon">🎨</text>
        <text class="btn-label">滤镜</text>
      </view>
      <view class="mirror-shutter-wrapper">
        <view class="mirror-shutter-btn" bindtap="onShutter" hover-class="shutter-hover">
          <view class="mirror-shutter-inner"></view>
        </view>
      </view>
      <view class="mirror-bottom-btn {{lightOn ? 'active' : ''}}" bindtap="onToggleLight" hover-class="btn-hover">
        <text class="btn-icon">💡</text>
        <text class="btn-label">补光</text>
      </view>
    </view>
  </view>

  <!-- 妆容步骤拆解 -->
  <view class="tutorial-list">
    <view class="section-header">
      <view class="section-title section-title-sm">妆容步骤拆解</view>
      <view class="badge badge-primary badge-pill">{{currentStep}} / {{totalSteps}} 步</view>
    </view>

    <view class="tutorial-progress-bar">
      <view class="tutorial-progress-fill" style="width: {{progressPercent}}%;"></view>
    </view>

    <!-- 面部落笔动线指南 -->
    <view class="tutorial-motion-guide">
      <view class="tutorial-motion-header">
        <view class="tutorial-motion-title">面部落笔动线指南</view>
        <view class="badge badge-secondary badge-pill">当前：{{currentStepName}}</view>
      </view>

      <view class="tutorial-face-guide">
        <image-safe src="{{faceGuideImage}}" class="tutorial-face-bg" mode="aspectFill" />
        <view class="tutorial-face-overlay">
          <view class="face-step-marker step-{{currentStep}}">
            <text class="marker-num">{{currentStep}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 步骤卡片列表 -->
    <view class="tutorial-steps">
      <view
        class="tutorial-step-card {{item.step === currentStep ? 'current' : ''}} {{item.step < currentStep ? 'done' : ''}}"
        wx:for="{{stepList}}"
        wx:key="step"
        data-step="{{item.step}}"
        bindtap="onStepTap"
        hover-class="card-hover"
      >
        <view class="step-num">{{item.step < currentStep ? '✓' : item.step}}</view>
        <view class="step-content">
          <view class="step-header">
            <text class="step-icon">{{item.icon}}</text>
            <text class="step-name">{{item.name}}</text>
            <text class="step-duration">{{item.duration}}</text>
          </view>
          <text class="step-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 上一步/下一步 -->
    <view class="tutorial-nav">
      <button class="btn btn-outline nav-btn" bindtap="onPrevStep" disabled="{{currentStep <= 1}}">上一步</button>
      <button class="btn btn-primary nav-btn" bindtap="onNextStep">{{currentStep >= totalSteps ? '完成妆容' : '下一步'}}</button>
    </view>
  </view>

  <!-- 闺蜜浮窗 -->
  <companion-fab bind:tap="onCompanionFabTap"></companion-fab>
</view>
