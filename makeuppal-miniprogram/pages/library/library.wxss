/* pages/library/library.wxss - 颜库页样式 */

.library-page {
  padding: 0 var(--spacing-4);
}

/* ===== 顶部 ===== */
.library-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-bg);
  padding-top: var(--spacing-3);
}

.library-search-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.library-mode-switch {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 3px;
  box-shadow: var(--shadow-xs);
}

.mode-switch-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  transition: all var(--duration-fast) var(--ease);
}

.mode-switch-btn.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
}

.mode-icon {
  font-size: 18px;
}

.library-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  padding: 8px 14px;
  box-shadow: var(--shadow-xs);
}

.search-icon {
  font-size: 14px;
  margin-right: 6px;
}

.search-placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.library-publish-btn {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  padding: 8px 16px;
  border-radius: var(--radius-full);
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(196, 149, 106, 0.3);
}

/* ===== 类目栏 ===== */
.library-cat-tabs {
  white-space: nowrap;
  margin-top: var(--spacing-3);
  padding-bottom: var(--spacing-2);
}

.library-cat-tab {
  display: inline-block;
  padding: 6px 14px;
  margin-right: 8px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  transition: all var(--duration-fast) var(--ease);
}

.library-cat-tab.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-weight: var(--font-weight-medium);
}

/* ===== 子类目栏 ===== */
.library-sub-tabs-wrapper {
  padding: var(--spacing-2) 0;
}

.library-sub-tabs {
  white-space: nowrap;
}

.library-sub-tab {
  display: inline-block;
  padding: 4px 12px;
  margin-right: 6px;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  border-radius: var(--radius-full);
}

.library-sub-tab.active {
  color: var(--color-primary);
  background: rgba(196, 149, 106, 0.1);
  font-weight: var(--font-weight-medium);
}

/* ===== Tinder 卡片 ===== */
.tinder-container {
  position: relative;
}

.tinder-stack {
  width: 100%;
  height: 500px;
  max-height: calc(100vh - 320px);
  position: relative;
}

.tinder-card {
  width: calc(100% - 32px);
  height: 460px;
  max-height: calc(100vh - 360px);
  position: absolute;
  left: 16px;
  top: 10px;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.tinder-card.next-card {
  transform: scale(0.95);
  opacity: 0.7;
  z-index: 1;
}

.tinder-card.current-card {
  z-index: 2;
}

.tinder-card-img {
  width: 100%;
  height: 60%;
}

.tinder-card-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
}

.like-stamp {
  font-size: 32px;
  font-weight: bold;
  color: var(--color-success);
  border: 4px solid var(--color-success);
  padding: 8px 20px;
  border-radius: var(--radius-md);
  transform: rotate(-20deg);
  opacity: 0.8;
}

.reject-stamp {
  font-size: 32px;
  font-weight: bold;
  color: var(--color-danger);
  border: 4px solid var(--color-danger);
  padding: 8px 20px;
  border-radius: var(--radius-md);
  transform: rotate(20deg);
  opacity: 0.8;
}

.tinder-card-info {
  padding: 16px;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,0.75));
  color: #fff;
}

.tinder-card-name {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  display: block;
  margin-bottom: 4px;
}

.tinder-card-desc {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.tinder-card-author {
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 6px;
}

.tinder-card-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.tinder-tag {
  font-size: var(--font-size-xs);
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.tinder-card-price {
  font-size: var(--font-size-sm);
  color: var(--color-accent);
  font-weight: var(--font-weight-semibold);
}

/* ===== 操作按钮 ===== */
.tinder-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-6);
  padding: var(--spacing-4) 0;
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(var(--tab-bar-height) + var(--safe-bottom) + 10px);
  z-index: 50;
  pointer-events: none;
}

.tinder-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
  pointer-events: auto;
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease);
}

.tinder-btn:active {
  transform: scale(0.92);
}

.tinder-btn-icon {
  font-size: 24px;
  line-height: 1;
}

.tinder-btn-label {
  font-size: 9px;
  color: var(--color-text-muted);
  margin-top: 2px;
}

.tinder-btn-reject .tinder-btn-icon { color: var(--color-danger); }
.tinder-btn-like .tinder-btn-icon { color: var(--color-success); }
.tinder-btn-rewind .tinder-btn-icon { color: var(--color-primary); }

.tinder-btn-rewind.disabled {
  opacity: 0.4;
}

.tinder-btn-like {
  width: 70px;
  height: 70px;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.tinder-btn-like .tinder-btn-icon { color: #fff; font-size: 28px; }
.tinder-btn-like .tinder-btn-label { color: rgba(255, 255, 255, 0.9); }

/* ===== 瀑布流 ===== */
.waterfall-grid {
  display: flex;
  gap: 10px;
  padding-top: var(--spacing-3);
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.waterfall-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
}

.waterfall-item-img {
  width: 100%;
  height: 200px;
}

.waterfall-item-info {
  padding: 8px 10px;
}

.waterfall-item-name {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.waterfall-item-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 6px;
}

.waterfall-item-author {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

.waterfall-item-price {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}
