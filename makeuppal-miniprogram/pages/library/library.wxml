<!--pages/library/library.wxml-->
<view class="page-container library-page">

  <!-- 顶部：模式切换 + 搜索 + 发布 -->
  <view class="library-header">
    <view class="library-search-row">
      <view class="library-mode-switch">
        <view class="mode-switch-btn {{currentMode === 'card' ? 'active' : ''}}" bindtap="switchMode" data-mode="card" title="卡片模式">
          <text class="mode-icon">⊞</text>
        </view>
        <view class="mode-switch-btn {{currentMode === 'waterfall' ? 'active' : ''}}" bindtap="switchMode" data-mode="waterfall" title="瀑布流模式">
          <text class="mode-icon">≡</text>
        </view>
      </view>
      <view class="library-search-box" bindtap="onSearchTap">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索妆容、成分、美妆问题...</text>
      </view>
      <view class="library-publish-btn" bindtap="onPublishTap">发布</view>
    </view>

    <!-- 类目栏 -->
    <scroll-view class="library-cat-tabs" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="library-cat-tab {{currentCat === item.key ? 'active' : ''}}" wx:for="{{catTabs}}" wx:key="key" bindtap="switchCat" data-cat="{{item.key}}">{{item.label}}</view>
    </scroll-view>
  </view>

  <!-- 子类目栏（仅瀑布流模式显示） -->
  <view class="library-sub-tabs-wrapper" wx:if="{{showSubTabs}}">
    <scroll-view class="library-sub-tabs" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="library-sub-tab {{currentSubCat === item ? 'active' : ''}}" wx:for="{{subCatList}}" wx:key="*this" bindtap="switchSub" data-sub="{{item}}">{{item}}</view>
    </scroll-view>
  </view>

  <!-- 卡片模式（Tinder风格） -->
  <view class="tinder-container" wx:if="{{currentMode === 'card'}}">
    <movable-area class="tinder-stack">
      <!-- 下一张卡片（底层） -->
      <movable-view wx:if="{{nextCard}}" class="tinder-card next-card" direction="all" x="0" y="0" disabled="{{true}}">
        <image-safe src="{{nextCard.image}}" class="tinder-card-img" mode="aspectFill" />
        <view class="tinder-card-info">
          <text class="tinder-card-name">{{nextCard.name}}</text>
          <text class="tinder-card-desc">{{nextCard.desc}}</text>
        </view>
      </movable-view>
      <!-- 当前卡片（顶层，可拖动） -->
      <movable-view wx:if="{{currentCard}}" class="tinder-card current-card swipe-{{swipeDirection}}" direction="all" x="{{cardX}}" y="{{cardY}}" bindchange="onCardChange" bindtouchend="onCardTouchEnd" bindtap="onCardTap">
        <image-safe src="{{currentCard.image}}" class="tinder-card-img" mode="aspectFill" />
        <view class="tinder-card-overlay">
          <view class="like-stamp" wx:if="{{swipeDirection === 'right'}}">喜欢 ♥</view>
          <view class="reject-stamp" wx:if="{{swipeDirection === 'left'}}">不喜欢 ✕</view>
        </view>
        <view class="tinder-card-info">
          <text class="tinder-card-name">{{currentCard.name}}</text>
          <text class="tinder-card-author">{{currentCard.author}} · {{currentCard.likes}} 赞</text>
          <view class="tinder-card-tags">
            <text class="tinder-tag" wx:for="{{currentCard.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <text class="tinder-card-price">{{currentCard.price}}</text>
        </view>
      </movable-view>
      <!-- 空状态 -->
      <empty-state wx:if="{{!currentCard}}" icon="📚" title="暂无更多内容" desc="切换其他类目看看吧" />
    </movable-area>

    <!-- 操作按钮 -->
    <view class="tinder-actions" wx:if="{{currentCard}}">
      <view class="tinder-btn tinder-btn-reject" bindtap="onDislike">
        <text class="tinder-btn-icon">✕</text>
        <text class="tinder-btn-label">不喜欢</text>
      </view>
      <view class="tinder-btn tinder-btn-rewind {{currentCardIndex === 0 ? 'disabled' : ''}}" bindtap="onRewind">
        <text class="tinder-btn-icon">↶</text>
        <text class="tinder-btn-label">回看</text>
      </view>
      <view class="tinder-btn tinder-btn-like" bindtap="onLike">
        <text class="tinder-btn-icon">♥</text>
        <text class="tinder-btn-label">喜欢</text>
      </view>
    </view>
  </view>

  <!-- 瀑布流模式 -->
  <view class="waterfall-grid" wx:if="{{currentMode === 'waterfall'}}">
    <view class="waterfall-column">
      <view class="waterfall-item" wx:for="{{waterfallLeft}}" wx:key="id" bindtap="onWaterfallTap" data-id="{{item.id}}">
        <image-safe src="{{item.image}}" class="waterfall-item-img" mode="aspectFill" />
        <view class="waterfall-item-info">
          <text class="waterfall-item-name">{{item.name}}</text>
          <view class="waterfall-item-bottom">
            <text class="waterfall-item-author">{{item.author}}</text>
            <text class="waterfall-item-price">{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="waterfall-column">
      <view class="waterfall-item" wx:for="{{waterfallRight}}" wx:key="id" bindtap="onWaterfallTap" data-id="{{item.id}}">
        <image-safe src="{{item.image}}" class="waterfall-item-img" mode="aspectFill" />
        <view class="waterfall-item-info">
          <text class="waterfall-item-name">{{item.name}}</text>
          <view class="waterfall-item-bottom">
            <text class="waterfall-item-author">{{item.author}}</text>
            <text class="waterfall-item-price">{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 40px;"></view>

  <companion-fab bind:tap="onCompanionFabTap" />
</view>
