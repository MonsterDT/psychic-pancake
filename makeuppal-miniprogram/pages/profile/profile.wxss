/* pages/profile/profile.wxss - 我的页样式 */

.profile-page {
  padding: 0;
  padding-bottom: calc(var(--tab-bar-height) + var(--safe-bottom) + 20px);
  background: var(--color-bg);
  min-height: 100vh;
}

/* ===== 用户信息横幅 ===== */
.profile-banner {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
  padding: calc(var(--safe-top) + 20px) 16px 20px;
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
}

.avatar-profile {
  position: relative;
  width: 64px;
  height: 64px;
  flex-shrink: 0;
}

.avatar-img {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.6);
}

.avatar-ring {
  position: absolute;
  top: -4px;
  left: -4px;
  right: -4px;
  bottom: -4px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.profile-name {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.name-text {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: #FFF8F0;
}

.level-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 255, 255, 0.25);
  padding: 3px 10px;
  border-radius: var(--radius-full);
  margin-bottom: 6px;
}

.level-icon {
  font-size: 10px;
}

.level-text {
  font-size: var(--font-size-xs);
  color: #FFF8F0;
  font-weight: var(--font-weight-medium);
}

.profile-bio {
  font-size: var(--font-size-xs);
  color: rgba(255, 248, 240, 0.85);
}

.btn-edit-profile {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 255, 255, 0.25);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.btn-edit-profile .edit-icon {
  font-size: 12px;
}

.btn-edit-profile .edit-text {
  font-size: var(--font-size-sm);
  color: #FFF8F0;
}

.btn-edit-profile.btn-hover {
  background: rgba(255, 255, 255, 0.4);
}

/* stats */
.profile-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-lg);
  padding: 14px 8px;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.stat-num {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: #FFF8F0;
}

.stat-label {
  font-size: var(--font-size-xs);
  color: rgba(255, 248, 240, 0.8);
}

.stat-divider {
  width: 1px;
  height: 24px;
  background: rgba(255, 255, 255, 0.3);
}

.stat.stat-hover {
  opacity: 0.7;
}

/* ===== 面部档案卡（slim版） ===== */
.profile-face-card {
  margin: 16px;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 14px;
  box-shadow: var(--shadow-sm);
}

.profile-face-card.card-hover {
  background: var(--color-bg-alt);
}

.face-card-body-slim {
  display: flex;
  align-items: center;
  gap: 12px;
  max-height: 80px;
}

.face-slim-avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  flex-shrink: 0;
}

.face-slim-info {
  flex: 1;
  min-width: 0;
}

.face-slim-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}

.face-slim-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.face-slim-score {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.face-slim-detail {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-bottom: 6px;
}

.face-slim-detail .dot {
  margin: 0 4px;
  color: var(--color-text-muted);
}

.face-slim-tags {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

.face-slim-tag {
  font-size: var(--font-size-xs);
  color: var(--color-primary-dark);
  background: var(--color-bg-alt);
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.face-slim-arrow {
  flex-shrink: 0;
}

.face-slim-arrow .arrow-icon {
  font-size: 20px;
  color: var(--color-text-muted);
}

/* ===== GP大卡 ===== */
.profile-gp-card {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 0 16px 16px;
  background: linear-gradient(135deg, #FFF8F0 0%, var(--color-bg-alt) 100%);
  border-radius: var(--radius-lg);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border-light);
}

.profile-gp-card.card-hover {
  box-shadow: var(--shadow-md);
}

.profile-gp-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(196, 149, 106, 0.3);
}

.profile-gp-info {
  flex: 1;
}

.profile-gp-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 4px;
}

.profile-gp-subtitle {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.profile-gp-balance {
  text-align: right;
  flex-shrink: 0;
}

.profile-gp-num {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  line-height: 1.2;
}

.profile-gp-go {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  margin-top: 2px;
}

/* ===== 功能宫格 ===== */
.profile-grid-5,
.profile-grid-3 {
  display: grid;
  gap: 10px;
  padding: 8px 16px;
  margin-bottom: 8px;
}

.profile-grid-5 {
  grid-template-columns: repeat(5, 1fr);
}

.profile-grid-3 {
  grid-template-columns: repeat(3, 1fr);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 16px;
  box-shadow: var(--shadow-xs);
}

.profile-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 10px 4px;
  border-radius: var(--radius-md);
  transition: all var(--duration-fast) var(--ease);
}

.profile-grid-item.grid-hover {
  background: var(--color-bg-alt);
  transform: scale(0.96);
}

.profile-grid-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: var(--color-bg-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}

.profile-grid-3 .profile-grid-icon {
  background: linear-gradient(135deg, var(--color-bg-alt), var(--color-border-light));
}

.profile-grid-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-align: center;
}

.bottom-spacer {
  height: 20px;
}
