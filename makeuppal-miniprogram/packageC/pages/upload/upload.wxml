<!-- packageC/pages/upload/upload.wxml -->
<view class="page-container upload-page">
  <!-- 顶部进度指示器 1-2-3-4 -->
  <view class="stepper">
    <block wx:for="{{steps}}" wx:key="step">
      <view class="step-node {{currentStep >= item.step ? 'step-node--active' : ''}}">
        <text class="step-num">{{item.step}}</text>
      </view>
      <text class="step-label {{currentStep >= item.step ? 'step-label--active' : ''}}">{{item.label}}</text>
      <view wx:if="{{item.step < 4}}" class="step-line {{currentStep > item.step ? 'step-line--active' : ''}}"></view>
    </block>
  </view>

  <!-- 步骤1：选择类目 -->
  <view wx:if="{{currentStep === 1}}" class="step-panel">
    <view class="panel-title">选择作品类目</view>
    <view class="cat-grid">
      <view
        class="cat-card {{selectedCategory === item.key ? 'cat-card--active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >
        <text class="cat-icon">{{item.icon}}</text>
        <text class="cat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 步骤2：上传图片 -->
  <view wx:if="{{currentStep === 2}}" class="step-panel">
    <view class="panel-title">上传作品图片</view>
    <view class="media-grid">
      <view class="media-item" wx:for="{{mediaList}}" wx:key="tempFilePath" wx:for-index="idx">
        <image class="media-img" src="{{item.tempFilePath}}" mode="aspectFill"></image>
        <view class="media-remove" data-index="{{idx}}" bindtap="onRemoveMedia">
          <text class="media-remove-icon">×</text>
        </view>
      </view>
      <view class="media-add" bindtap="onChooseMedia">
        <text class="media-add-icon">＋</text>
        <text class="media-add-text">添加图片</text>
      </view>
    </view>
    <text class="media-tip">最多9张，第一张为封面</text>
  </view>

  <!-- 步骤3：填写信息 -->
  <view wx:if="{{currentStep === 3}}" class="step-panel">
    <view class="panel-title">填写作品信息</view>
    <view class="form-group">
      <text class="form-label">标题</text>
      <input class="form-input" value="{{form.title}}" bindinput="onTitleInput" placeholder="请输入作品标题（最多30字）" maxlength="30" />
    </view>
    <view class="form-group">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" value="{{form.desc}}" bindinput="onDescInput" placeholder="详细介绍你的作品..." maxlength="200"></textarea>
    </view>
    <view class="form-group">
      <text class="form-label">标签</text>
      <input class="form-input" value="{{form.tags}}" bindinput="onTagsInput" placeholder="多个标签用空格分隔" />
    </view>
    <view class="form-group">
      <text class="form-label">价格（GP）</text>
      <input class="form-input" value="{{form.priceGP}}" bindinput="onPriceInput" type="number" placeholder="0 表示免费" />
    </view>
  </view>

  <!-- 步骤4：预览确认 -->
  <view wx:if="{{currentStep === 4}}" class="step-panel">
    <view class="panel-title">预览确认</view>
    <view class="preview-card card">
      <image class="preview-cover" src="{{preview.cover}}" mode="aspectFill"></image>
      <view class="preview-info">
        <text class="preview-title">{{preview.title}}</text>
        <text class="preview-desc ellipsis-2">{{preview.desc}}</text>
        <view class="preview-meta">
          <text class="preview-chip">类目：{{preview.categoryLabel}}</text>
          <text class="preview-chip">{{preview.imgCount}} 张图</text>
          <text class="preview-chip chip-primary">{{preview.priceGP}} GP</text>
        </view>
        <text wx:if="{{preview.tags}}" class="preview-tags">标签：{{preview.tags}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏：发布按钮仅在步骤4（流程末端）显示 -->
  <view class="upload-bottom">
    <view wx:if="{{currentStep > 1}}" class="btn btn-outline upload-btn" bindtap="onPrev">上一步</view>
    <view wx:if="{{currentStep < 4}}" class="btn btn-primary upload-btn upload-btn--primary" bindtap="onNext">下一步</view>
    <view wx:if="{{currentStep === 4}}" class="btn btn-primary upload-btn upload-btn--primary" bindtap="onPublish">立即发布</view>
  </view>
</view>
