/* packageC/pages/upload/upload.wxss */

.upload-page {
  padding: var(--spacing-4);
  padding-bottom: 120px;
}

/* 进度指示器 */
.stepper {
  display: flex;
  align-items: center;
  padding: var(--spacing-4) var(--spacing-2);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.step-node {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-node--active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.step-num {
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: bold;
}

.step-label {
  margin-left: 6px;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.step-label--active {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.step-line {
  flex: 1;
  height: 2px;
  background: var(--color-border);
  margin: 0 6px;
}

.step-line--active {
  background: var(--color-primary);
}

/* 步骤面板 */
.step-panel {
  margin-top: var(--spacing-4);
}

.panel-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: var(--spacing-3);
}

/* 类目网格 */
.cat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--spacing-3);
}

.cat-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-4) var(--spacing-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2px solid transparent;
  transition: all var(--duration-fast) var(--ease);
}

.cat-card--active {
  border-color: var(--color-primary);
  background: rgba(196, 149, 106, 0.08);
}

.cat-icon {
  font-size: 28px;
}

.cat-label {
  margin-top: 6px;
  font-size: var(--font-size-sm);
  color: var(--color-text);
}

/* 媒体网格 */
.media-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--spacing-2);
}

.media-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-alt);
}

.media-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.media-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-remove-icon {
  color: #fff;
  font-size: 16px;
  line-height: 1;
}

.media-add {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  border: 2px dashed var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.media-add::after {
  content: '';
  display: block;
}

.media-add-icon,
.media-add-text {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
}

.media-add-icon {
  top: 38%;
  font-size: 30px;
  color: var(--color-primary);
  line-height: 1;
}

.media-add-text {
  top: 62%;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.media-tip {
  display: block;
  margin-top: var(--spacing-3);
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 表单 */
.form-group {
  margin-bottom: var(--spacing-4);
}

.form-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 6px;
}

.form-input {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.form-textarea {
  width: 100%;
  min-height: 90px;
  padding: 10px 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  font-size: var(--font-size-base);
  color: var(--color-text);
  box-sizing: border-box;
}

/* 预览 */
.preview-card {
  padding: var(--spacing-3);
}

.preview-cover {
  width: 100%;
  height: 200px;
  border-radius: var(--radius-md);
}

.preview-info {
  margin-top: var(--spacing-3);
}

.preview-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.preview-desc {
  margin-top: 6px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.preview-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--spacing-2);
}

.preview-chip {
  padding: 4px 10px;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-right: 6px;
  margin-bottom: 6px;
}

.preview-tags {
  display: block;
  margin-top: 6px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 底部操作栏 */
.upload-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: var(--spacing-3) var(--spacing-4);
  padding-bottom: calc(var(--safe-bottom) + var(--spacing-3));
  background: var(--color-bg-card);
  box-shadow: 0 -2px 10px rgba(45, 42, 38, 0.06);
  z-index: var(--z-sheet);
}

.upload-btn {
  flex: 1;
  margin: 0 6px;
}

.upload-btn--primary {
  margin-left: 6px;
}
