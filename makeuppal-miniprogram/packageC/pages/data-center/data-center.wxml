<!-- packageC/pages/data-center/data-center.wxml -->
<view class="page-container dc-page">
  <!-- 数据概览卡片 -->
  <view class="overview-grid">
    <view class="overview-card" wx:for="{{overview}}" wx:key="key">
      <text class="overview-value">{{item.value}}</text>
      <text class="overview-label">{{item.label}}</text>
      <text class="overview-trend">{{item.trend}}</text>
    </view>
  </view>

  <!-- 7天趋势图（view 柱状图模拟）-->
  <view class="trend-card card">
    <view class="trend-header">
      <text class="trend-title">近7天播放趋势</text>
      <text class="trend-unit">单位：次</text>
    </view>
    <view class="trend-chart">
      <view class="trend-bar-wrap" wx:for="{{trendList}}" wx:key="day">
        <view class="trend-bar" style="height: {{item.heightPercent}}%;"></view>
        <text class="trend-bar-val">{{item.value}}</text>
        <text class="trend-bar-day">{{item.day}}</text>
      </view>
    </view>
  </view>

  <!-- TOP作品列表 -->
  <view class="section-header">
    <text class="section-title">TOP 作品</text>
    <text class="section-more">按播放量</text>
  </view>
  <view class="top-list">
    <view class="top-item card" wx:for="{{topWorks}}" wx:key="id" data-id="{{item.id}}" bindtap="onWorkTap">
      <view class="top-rank">{{index + 1}}</view>
      <image class="top-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="top-info">
        <text class="top-title ellipsis">{{item.title}}</text>
        <view class="top-stats">
          <text class="top-stat">播放 {{item.plays}}</text>
          <text class="top-stat">点赞 {{item.likes}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
