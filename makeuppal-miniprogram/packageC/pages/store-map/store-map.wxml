<!-- packageC/pages/store-map/store-map.wxml -->
<view class="store-map-page">
  <!-- 全屏地图 -->
  <map
    class="map-view"
    longitude="{{center.longitude}}"
    latitude="{{center.latitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    bindmarkertap="onMarkerTap"
    show-location
  ></map>

  <!-- 底部门店信息卡 -->
  <view class="store-card" wx:if="{{activeStore}}">
    <view class="store-card-head">
      <text class="store-name ellipsis">{{activeStore.name}}</text>
      <text class="store-distance">{{activeStore.distance}}</text>
    </view>
    <text class="store-address ellipsis-2">{{activeStore.address}}</text>
    <view class="store-nav-btn" bindtap="onNavigateTap">
      <text class="store-nav-text">导航到这</text>
    </view>
  </view>
</view>
