/* packageC/pages/invite/invite.wxss */

.invite-page {
  padding: var(--spacing-4);
}

/* 海报区 */
.poster-card {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: var(--spacing-6) var(--spacing-4);
  color: #fff;
}

.poster-top {
  text-align: center;
}

.poster-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: #fff;
}

.poster-sub {
  display: block;
  margin-top: 6px;
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.9);
}

.reward-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-5);
}

.reward-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reward-num {
  font-size: var(--font-size-2xl);
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.reward-label {
  margin-top: 4px;
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.85);
}

.reward-divider {
  width: 1px;
  height: 32px;
  background: rgba(255, 255, 255, 0.4);
}

.reward-rules {
  margin-top: var(--spacing-5);
  padding-top: var(--spacing-4);
  border-top: 1px solid rgba(255, 255, 255, 0.25);
}

.rule-title {
  display: block;
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.9);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-2);
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-top: 4px;
}

.rule-dot {
  color: #fff;
  margin-right: 6px;
  line-height: 1.5;
}

.rule-text {
  flex: 1;
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

/* 邀请码 */
.code-card {
  margin-top: var(--spacing-4);
  padding: var(--spacing-4);
}

.code-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--spacing-2);
}

.code-value {
  font-size: var(--font-size-2xl);
  font-weight: bold;
  color: var(--color-primary);
  letter-spacing: 2px;
}

.copy-btn {
  padding: 6px 18px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.copy-btn-text {
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}

/* 分享按钮 */
.share-btn {
  margin-top: var(--spacing-4);
  width: 100%;
  height: 50px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 18px rgba(196, 149, 106, 0.35);
  border: none;
  line-height: 50px;
  padding: 0;
}

.share-btn::after {
  border: none;
}

.share-btn-text {
  color: #fff;
}

/* 已邀请好友列表 */
.invitee-list {
  margin-top: var(--spacing-2);
  overflow: hidden;
}

.invitee-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-3) var(--spacing-4);
  border-bottom: 1px solid var(--color-border-light);
}

.invitee-item:last-child {
  border-bottom: none;
}

.invitee-avatar {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.invitee-info {
  flex: 1;
  margin-left: var(--spacing-3);
  min-width: 0;
}

.invitee-name {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
}

.invitee-status {
  display: block;
  margin-top: 2px;
  font-size: var(--font-size-xs);
  color: var(--color-success);
}

.invitee-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.invitee-reward {
  font-size: var(--font-size-sm);
  font-weight: bold;
  color: var(--color-primary);
}

.invitee-time {
  margin-top: 2px;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}
