/* packageC/pages/creator/creator.wxss */

.creator-page {
  padding: 0 var(--spacing-4);
}

/* 创作者信息头 */
.creator-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFFFFF, #FFF1E6);
  border-radius: var(--radius-lg);
  padding: var(--spacing-4);
  margin-top: var(--spacing-3);
  box-shadow: var(--shadow-sm);
}

.creator-avatar {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  border: 2px solid var(--color-accent);
}

.creator-meta {
  flex: 1;
  margin-left: var(--spacing-3);
  min-width: 0;
}

.creator-name-row {
  display: flex;
  align-items: center;
}

.creator-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.creator-level {
  margin-left: var(--spacing-2);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-xs);
}

.creator-bio {
  margin-top: 4px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 数据概览 4 卡 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: var(--spacing-2);
  margin-top: var(--spacing-4);
}

.stat-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-3) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: var(--font-size-2xl);
  font-weight: bold;
  color: var(--color-primary);
  line-height: 1.2;
}

.stat-label {
  margin-top: 4px;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 功能入口 */
.entry-row {
  margin-top: var(--spacing-4);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-4);
  border-bottom: 1px solid var(--color-border-light);
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-icon {
  font-size: 20px;
  margin-right: var(--spacing-3);
}

.entry-text {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.entry-arrow {
  color: var(--color-text-muted);
  font-size: var(--font-size-lg);
}

/* 作品列表 */
.works-list {
  margin-top: var(--spacing-2);
}

.work-item {
  display: flex;
  padding: var(--spacing-3);
  margin-bottom: var(--spacing-3);
}

.work-cover {
  width: 96px;
  height: 96px;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.work-info {
  flex: 1;
  margin-left: var(--spacing-3);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.work-title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  line-height: 1.4;
}

.work-stats {
  display: flex;
  margin-top: var(--spacing-2);
}

.work-stat {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-right: var(--spacing-3);
}

.work-status {
  align-self: flex-start;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  margin-top: var(--spacing-2);
}

.work-status--published {
  background: rgba(107, 158, 107, 0.12);
  color: var(--color-success);
}

.work-status--reviewing {
  background: rgba(212, 160, 60, 0.14);
  color: var(--color-warning);
}

.work-status--draft {
  background: rgba(155, 149, 144, 0.14);
  color: var(--color-text-muted);
}

.fab-placeholder {
  height: 80px;
}

/* 发布入口按钮 */
.publish-fab {
  position: fixed;
  left: var(--spacing-4);
  right: var(--spacing-4);
  bottom: calc(var(--safe-bottom) + var(--spacing-3));
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 6px 18px rgba(196, 149, 106, 0.35);
  z-index: var(--z-sheet);
}

.publish-icon {
  font-size: 22px;
  color: #fff;
  margin-right: 6px;
  line-height: 1;
}

.publish-text {
  color: #fff;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
