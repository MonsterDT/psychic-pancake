/* packageD/pages/trending/trending.wxss */
.trending-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(var(--safe-bottom) + 24px);
}

/* 榜单tab */
.trending-tabs {
  display: flex;
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border-light);
  position: sticky;
  top: 0;
  z-index: var(--z-tab);
}

.trending-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 0 12px;
  position: relative;
}

.tab-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.trending-tab.active .tab-text {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.tab-underline {
  position: absolute;
  bottom: 0;
  width: 32px;
  height: 3px;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: 2px;
}

/* TOP3 特殊样式 */
.top3 {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding: var(--spacing-5) var(--spacing-3) var(--spacing-4);
  background: linear-gradient(180deg, var(--color-bg-alt), var(--color-bg));
}

.top3-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.top3-1st {
  margin-bottom: var(--spacing-3);
}

.top3-crown {
  font-size: 32px;
  margin-bottom: 4px;
  animation: crownFloat 2s ease-in-out infinite;
}

@keyframes crownFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

.top3-avatar {
  width: 60px;
  height: 60px;
  border-radius: var(--radius-full);
  border: 3px solid var(--color-border);
  margin-bottom: 6px;
}

.top3-avatar-lg {
  width: 80px;
  height: 80px;
  border-color: var(--color-warning);
}

.top3-1st .top3-avatar {
  width: 80px;
  height: 80px;
  border-color: var(--color-warning);
}

.top3-rank {
  width: 22px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 4px;
}

.rank-1 { background: linear-gradient(135deg, #F0C674, #D4A03C); }
.rank-2 { background: linear-gradient(135deg, #C0C0C0, #A0A0A0); }
.rank-3 { background: linear-gradient(135deg, #CD7F32, #B87333); }

.top3-name {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
  text-align: center;
  max-width: 100px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top3-author {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  margin-top: 2px;
}

.top3-likes {
  font-size: var(--font-size-xs);
  color: var(--color-danger);
  margin-top: 4px;
}

/* 排行榜列表 */
.rank-list {
  background: var(--color-bg-card);
  margin: 0 var(--spacing-3);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-3) var(--spacing-4);
  border-bottom: 1px solid var(--color-border-light);
  gap: var(--spacing-3);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 24px;
  text-align: center;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-muted);
}

.rank-avatar {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.rank-title {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-author {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.rank-likes {
  display: flex;
  align-items: center;
  gap: 4px;
}

.likes-icon {
  font-size: 12px;
}

.likes-num {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  font-weight: var(--font-weight-medium);
}
