/* packageD/pages/face-auth/face-auth.wxss */
.face-auth-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--spacing-6) var(--spacing-5);
  padding-bottom: calc(var(--safe-bottom) + 24px);
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 步骤1：说明页 */
.step-intro {
  padding-top: var(--spacing-10);
}

.intro-icon {
  font-size: 64px;
  margin-bottom: var(--spacing-4);
}

.intro-title {
  font-size: 26px;
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  margin-bottom: var(--spacing-2);
}

.intro-subtitle {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-8);
}

.intro-uses {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-5);
}

.use-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
  padding: var(--spacing-3) 0;
  border-bottom: 1px solid var(--color-border-light);
}

.use-item:last-child {
  border-bottom: none;
}

.use-icon {
  font-size: 28px;
  width: 36px;
  text-align: center;
}

.use-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.use-title {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
}

.use-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.intro-privacy {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: var(--spacing-6);
  padding: 0 var(--spacing-2);
}

.privacy-icon {
  font-size: 14px;
}

.privacy-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  flex: 1;
}

/* 主按钮 */
.primary-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border-radius: var(--radius-full);
  padding: 12px 0;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border: none;
  margin-top: var(--spacing-2);
}

/* 步骤2：拍照 */
.step-capture {
  padding: 0;
  width: 100%;
}

.auth-camera {
  width: 100%;
  height: 70vh;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.camera-placeholder {
  width: 100%;
  height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  gap: var(--spacing-3);
}

.placeholder-emoji {
  font-size: 48px;
}

.placeholder-text {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-4);
}

.face-guide {
  position: absolute;
  top: 35vh;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.face-oval {
  width: 200px;
  height: 260px;
  border: 3px dashed rgba(255, 248, 240, 0.85);
  border-radius: 50%;
}

.face-tip {
  margin-top: var(--spacing-3);
  font-size: var(--font-size-sm);
  color: #FFF8F0;
  background: rgba(0, 0, 0, 0.4);
  padding: 4px 14px;
  border-radius: var(--radius-full);
}

.capture-actions {
  width: 100%;
  margin-top: var(--spacing-4);
}

/* 步骤3：分析中 */
.step-analyzing {
  padding-top: 25vh;
}

.analyzing-ring {
  position: relative;
  width: 120px;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-5);
}

.ring-outer {
  position: absolute;
  width: 120px;
  height: 120px;
  border: 4px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1.2s linear infinite;
}

.ring-inner {
  position: absolute;
  width: 90px;
  height: 90px;
  border: 3px solid var(--color-border-light);
  border-bottom-color: var(--color-primary-light);
  border-radius: 50%;
  animation: spin 1.6s linear infinite reverse;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.analyzing-emoji {
  font-size: 36px;
}

.analyzing-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: var(--spacing-2);
}

.analyzing-tip {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 成功 */
.step-success {
  padding-top: 30vh;
}

.success-icon {
  width: 80px;
  height: 80px;
  line-height: 80px;
  text-align: center;
  background: linear-gradient(135deg, var(--color-success), #4F8A4F);
  color: #fff;
  font-size: 40px;
  border-radius: 50%;
  margin-bottom: var(--spacing-5);
  animation: pop 0.4s var(--ease);
}

@keyframes pop {
  0% { transform: scale(0); }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.success-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  margin-bottom: var(--spacing-2);
}

.success-tip {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-8);
}
