/* packageD/pages/mirror-settings/mirror-settings.wxss */
.mirror-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--spacing-4);
  padding-bottom: calc(100px + var(--safe-bottom));
}

/* 预览区 */
.preview-area {
  margin-bottom: var(--spacing-4);
}

.preview-mirror {
  height: 200px;
  background: linear-gradient(135deg, var(--color-bg-alt), var(--color-bg-card));
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border-light);
}

.preview-emoji {
  font-size: 64px;
  margin-bottom: var(--spacing-2);
}

.preview-text {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
}

/* 设置卡片 */
.settings-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-4);
}

.setting-item {
  padding: var(--spacing-3) 0;
  border-bottom: 1px solid var(--color-border-light);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-2);
}

.setting-label {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
}

.setting-value {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

/* 滤镜 */
.filter-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-4);
}

.card-title {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-3);
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: var(--spacing-3);
}

.filter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.filter-preview {
  width: 60px;
  height: 60px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid transparent;
  transition: all var(--duration-fast) var(--ease);
}

.filter-item.active .filter-preview {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(196, 149, 106, 0.2);
}

.filter-natural {
  background: linear-gradient(135deg, #FFE5D9, #FFFFFF);
}

.filter-warm {
  background: linear-gradient(135deg, #FFD4A3, #F5B97F);
}

.filter-cool {
  background: linear-gradient(135deg, #D4E5FF, #A3C4FF);
}

.filter-blackwhite {
  background: linear-gradient(135deg, #E8E8E8, #707070);
}

.filter-emoji {
  font-size: 24px;
}

.filter-name {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.filter-item.active .filter-name {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* 保存按钮 */
.save-btn-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  padding: var(--spacing-3) var(--spacing-4) calc(var(--safe-bottom) + 12px);
  box-shadow: 0 -2px 10px rgba(45, 42, 38, 0.06);
  z-index: var(--z-sheet);
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border-radius: var(--radius-full);
  padding: 12px 0;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border: none;
}
