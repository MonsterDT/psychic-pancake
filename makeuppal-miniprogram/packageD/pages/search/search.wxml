<!--packageD/pages/search/search.wxml-->
<view class="search-page">

  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索妆容、达人、教程..."
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        focus="{{autoFocus}}"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirm"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">✕</text>
    </view>
    <text class="search-cancel" bindtap="onCancel">取消</text>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{hasSearched}}">
    <view class="results-header">
      <text class="results-title">搜索结果（{{results.length}}）</text>
    </view>
    <view class="results-empty" wx:if="{{results.length === 0}}">
      <text class="empty-emoji">🔍</text>
      <text class="empty-text">未找到相关内容</text>
      <text class="empty-hint">换个关键词试试吧</text>
    </view>
    <view class="result-item" wx:for="{{results}}" wx:key="id" bindtap="onResultTap" data-id="{{item.id}}">
      <image-safe src="{{item.image}}" class="result-img" mode="aspectFill" />
      <view class="result-info">
        <text class="result-name">{{item.name}}</text>
        <text class="result-desc">{{item.desc}}</text>
        <view class="result-meta">
          <text class="result-author">{{item.author}}</text>
          <text class="result-likes">♥ {{item.likes}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 未搜索时：历史 + 热搜 -->
  <view class="search-default" wx:else>
    <!-- 搜索历史 -->
    <view class="block" wx:if="{{history.length > 0}}">
      <view class="block-header">
        <text class="block-title">搜索历史</text>
        <text class="block-action" bindtap="onClearHistory">清空</text>
      </view>
      <view class="history-tags">
        <view class="history-tag" wx:for="{{history}}" wx:key="*this" bindtap="onHistoryTap" data-key="{{item}}">{{item}}</view>
      </view>
    </view>

    <!-- 热搜推荐 -->
    <view class="block">
      <view class="block-header">
        <text class="block-title">🔥 热门搜索</text>
      </view>
      <view class="hot-list">
        <view class="hot-item" wx:for="{{hotList}}" wx:key="*this" bindtap="onHotTap" data-key="{{item}}">
          <text class="hot-rank rank-{{index + 1}}">{{index + 1}}</text>
          <text class="hot-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
