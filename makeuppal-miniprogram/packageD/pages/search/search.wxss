/* packageD/pages/search/search.wxss */
.search-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--spacing-3) var(--spacing-4);
  padding-bottom: calc(var(--safe-bottom) + 24px);
}

/* 顶部搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-4);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  padding: 8px 16px;
  box-shadow: var(--shadow-xs);
}

.search-icon {
  font-size: 14px;
  margin-right: 8px;
  color: var(--color-text-muted);
}

.search-input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text);
  height: 24px;
}

.search-placeholder {
  color: var(--color-text-muted);
  font-size: var(--font-size-base);
}

.search-clear {
  font-size: 14px;
  color: var(--color-text-muted);
  padding: 4px;
}

.search-cancel {
  font-size: var(--font-size-base);
  color: var(--color-primary);
  padding: 4px 8px;
}

/* 默认区块 */
.block {
  margin-top: var(--spacing-4);
}

.block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-3);
}

.block-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.block-action {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-2);
}

.history-tag {
  padding: 6px 14px;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-xs);
}

.hot-list {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-3) var(--spacing-4);
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--color-border-light);
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 24px;
  height: 24px;
  line-height: 24px;
  text-align: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-muted);
  margin-right: var(--spacing-3);
}

.rank-1 { color: var(--color-danger); }
.rank-2 { color: var(--color-warning); }
.rank-3 { color: var(--color-primary); }

.hot-text {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text);
}

/* 搜索结果 */
.results-header {
  padding: var(--spacing-2) 0 var(--spacing-3);
}

.results-title {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.results-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0;
}

.empty-emoji {
  font-size: 48px;
  margin-bottom: var(--spacing-3);
}

.empty-text {
  font-size: var(--font-size-lg);
  color: var(--color-text);
  margin-bottom: var(--spacing-2);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.result-item {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: var(--spacing-3);
}

.result-img {
  width: 100px;
  height: 100px;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  padding: var(--spacing-3);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4px;
}

.result-author {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.result-likes {
  font-size: var(--font-size-xs);
  color: var(--color-danger);
}
