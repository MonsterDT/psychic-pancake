<!--packageD/pages/companion-chat/companion-chat.wxml-->
<view class="chat-page">

  <!-- 消息列表 -->
  <scroll-view
    class="msg-list"
    scroll-y="{{true}}"
    scroll-into-view="{{scrollAnchor}}"
    scroll-with-animation="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <!-- 欢迎语 -->
    <view class="msg-item msg-xiaomei" id="msg-0">
      <view class="avatar-wrap">
        <text class="avatar-emoji">🌸</text>
      </view>
      <view class="bubble bubble-xiaomei">
        <text class="bubble-text">{{welcomeMessage}}</text>
      </view>
    </view>

    <!-- 历史消息 -->
    <view
      class="msg-item {{item.role === 'user' ? 'msg-user' : 'msg-xiaomei'}}"
      wx:for="{{messages}}"
      wx:key="idx"
      id="msg-{{item.idx}}"
    >
      <view class="avatar-wrap" wx:if="{{item.role !== 'user'}}">
        <text class="avatar-emoji">🌸</text>
      </view>
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-xiaomei'}}">
        <text class="bubble-text">{{item.content}}</text>
        <!-- 推荐模板 -->
        <view class="templates" wx:if="{{item.templates.length > 0}}">
          <view class="templates-title">为你推荐</view>
          <view class="template-card" wx:for="{{item.templates}}" wx:for-item="tpl" wx:key="id" bindtap="onTemplateTap" data-id="{{tpl.id}}">
            <image-safe src="{{tpl.image}}" class="template-img" mode="aspectFill" />
            <view class="template-info">
              <text class="template-name">{{tpl.name}}</text>
              <text class="template-author">{{tpl.author}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="avatar-wrap" wx:if="{{item.role === 'user'}}">
        <text class="avatar-emoji user-emoji">🙋</text>
      </view>
    </view>
  </scroll-view>

  <!-- 快捷场景按钮 -->
  <scroll-view class="quick-scenes" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view
      class="scene-btn {{currentScene === item.key ? 'active' : ''}}"
      wx:for="{{scenes}}"
      wx:key="key"
      bindtap="onSceneTap"
      data-key="{{item.key}}"
    >
      <text class="scene-icon">{{item.icon}}</text>
      <text class="scene-label">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <view class="input-voice-btn" bindtap="onVoiceToggle">
      <text class="voice-icon">{{isVoiceMode ? '⌨️' : '🎤'}}</text>
    </view>
    <view class="input-wrap" wx:if="{{!isVoiceMode}}">
      <input
        class="msg-input"
        type="text"
        placeholder="和小美聊聊美妆吧..."
        placeholder-class="msg-placeholder"
        value="{{inputText}}"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
      />
    </view>
    <view class="voice-hold-btn" wx:else>
      <text>按住说话</text>
    </view>
    <view class="send-btn {{inputText ? 'active' : ''}}" bindtap="onSend">
      <text>发送</text>
    </view>
  </view>
</view>
