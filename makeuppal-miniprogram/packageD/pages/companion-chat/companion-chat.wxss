/* packageD/pages/companion-chat/companion-chat.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: var(--spacing-3) var(--spacing-4);
  box-sizing: border-box;
}

.msg-item {
  display: flex;
  margin-bottom: var(--spacing-4);
  align-items: flex-start;
  gap: var(--spacing-2);
}

.msg-user {
  flex-direction: row-reverse;
}

.avatar-wrap {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 22px;
}

.user-emoji {
  background: rgba(196, 149, 106, 0.18);
}

/* 气泡 */
.bubble {
  max-width: 70%;
  padding: 10px 14px;
  border-radius: var(--radius-lg);
  position: relative;
}

.bubble-xiaomei {
  background: var(--color-bg-card);
  color: var(--color-text);
  border-top-left-radius: 4px;
  box-shadow: var(--shadow-xs);
}

.bubble-user {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border-top-right-radius: 4px;
}

.bubble-text {
  font-size: var(--font-size-base);
  line-height: 1.5;
}

/* 推荐模板 */
.templates {
  margin-top: var(--spacing-2);
  border-top: 1px solid var(--color-border-light);
  padding-top: var(--spacing-2);
}

.templates-title {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  margin-bottom: 6px;
  font-weight: var(--font-weight-medium);
}

.template-card {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 6px;
  padding: 6px;
  gap: var(--spacing-2);
}

.template-img {
  width: 50px;
  height: 50px;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.template-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.template-name {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-author {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 快捷场景 */
.quick-scenes {
  flex-shrink: 0;
  white-space: nowrap;
  padding: var(--spacing-2) var(--spacing-3);
  background: var(--color-bg-card);
  border-top: 1px solid var(--color-border-light);
}

.scene-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 6px 12px;
  margin-right: var(--spacing-2);
  background: var(--color-bg-alt);
  border-radius: var(--radius-md);
  min-width: 60px;
}

.scene-btn.active {
  background: rgba(196, 149, 106, 0.15);
}

.scene-icon {
  font-size: 22px;
}

.scene-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 2px;
}

.scene-btn.active .scene-label {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* 底部输入栏 */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
  padding: var(--spacing-2) var(--spacing-3);
  padding-bottom: calc(12px + var(--safe-bottom));
  background: var(--color-bg-card);
  border-top: 1px solid var(--color-border-light);
}

.input-voice-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-alt);
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.voice-icon {
  font-size: 18px;
}

.input-wrap {
  flex: 1;
  background: var(--color-bg-alt);
  border-radius: var(--radius-full);
  padding: 6px 16px;
}

.msg-input {
  width: 100%;
  height: 24px;
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.msg-placeholder {
  color: var(--color-text-muted);
  font-size: var(--font-size-base);
}

.voice-hold-btn {
  flex: 1;
  height: 36px;
  line-height: 36px;
  text-align: center;
  background: var(--color-bg-alt);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.send-btn {
  padding: 6px 16px;
  background: var(--color-border);
  color: var(--color-text-muted);
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease);
}

.send-btn.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
}
