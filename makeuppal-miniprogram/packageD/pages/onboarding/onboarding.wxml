<!--packageD/pages/onboarding/onboarding.wxml-->
<view class="onboarding-page">

  <!-- 顶部安全区占位 -->
  <view class="safe-top-placeholder" style="height: {{safeTop + 12}}px;"></view>

  <!-- 跳过按钮 -->
  <view class="skip-btn" bindtap="onSkip" wx:if="{{current < steps.length - 1}}">
    <text>跳过</text>
  </view>

  <!-- swiper 引导 -->
  <swiper
    class="onboarding-swiper"
    current="{{current}}"
    bindchange="onSwiperChange"
    indicator-dots="{{false}}"
    autoplay="{{false}}"
    duration="300"
  >
    <swiper-item wx:for="{{steps}}" wx:key="step">
      <view class="slide">
        <view class="slide-img-wrap">
          <image-safe src="{{item.image}}" class="slide-img" mode="aspectFill" />
        </view>
        <view class="slide-text">
          <text class="slide-title">{{item.title}}</text>
          <text class="slide-desc">{{item.desc}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 指示点 -->
  <view class="indicators">
    <view
      class="indicator {{current === index ? 'active' : ''}}"
      wx:for="{{steps}}"
      wx:key="step"
    ></view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <block wx:if="{{current < steps.length - 1}}">
      <button class="next-btn" bindtap="onNext">下一步</button>
    </block>
    <block wx:else>
      <button class="next-btn" bindtap="onStart">立即体验</button>
    </block>
  </view>

  <!-- 底部安全区占位 -->
  <view style="height: calc({{safeBottom}}px + 24px);"></view>
</view>
