<!-- components/modal/modal.wxml -->
<view wx:if="{{visible}}" class="modal-overlay {{closing ? 'closing' : ''}}" bindtap="onOverlayTap" catchtouchmove="noop">
  <view class="modal-container {{closing ? 'closing' : ''}}" catchtap="noop">
    <view class="modal-header" wx:if="{{title}}">
      <text class="modal-title">{{title}}</text>
      <view class="modal-close" bindtap="onClose">
        <text class="modal-close-icon">✕</text>
      </view>
    </view>
    <view class="modal-body">
      <slot></slot>
    </view>
    <view class="modal-footer" wx:if="{{showFooter}}">
      <slot name="footer"></slot>
    </view>
  </view>
</view>
