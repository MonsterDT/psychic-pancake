/* components/user-avatar/user-avatar.wxss */
.user-avatar {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
}

.avatar-wrap {
  position: relative;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--color-accent), var(--color-primary-light));
  box-shadow: var(--shadow-sm);
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-accent), var(--color-primary-light));
}

.avatar-initial {
  color: #fff;
  font-weight: var(--font-weight-semibold);
  line-height: 1;
}

.avatar-name {
  margin-left: var(--spacing-2);
  font-size: var(--font-size-base);
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
}

/* 尺寸 sm */
.avatar-wrap--sm { width: 32px; height: 32px; }
.avatar-wrap--sm .avatar-initial { font-size: 13px; }
.user-avatar--sm .avatar-name { font-size: var(--font-size-sm); }

/* 尺寸 md */
.avatar-wrap--md { width: 48px; height: 48px; }
.avatar-wrap--md .avatar-initial { font-size: 18px; }

/* 尺寸 lg */
.avatar-wrap--lg { width: 64px; height: 64px; }
.avatar-wrap--lg .avatar-initial { font-size: 24px; }

/* 尺寸 xl */
.avatar-wrap--xl { width: 80px; height: 80px; }
.avatar-wrap--xl .avatar-initial { font-size: 30px; }
