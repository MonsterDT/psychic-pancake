<!-- components/bottom-sheet/bottom-sheet.wxml -->
<view wx:if="{{visible}}" class="bs-overlay {{closing ? 'closing' : ''}}" bindtap="onOverlayTap" catchtouchmove="noop">
  <view class="bs-container {{closing ? 'closing' : ''}}" catchtap="noop">
    <view class="bs-handle"></view>
    <view class="bs-header" wx:if="{{title}}">
      <text class="bs-title">{{title}}</text>
      <view class="bs-close" bindtap="onClose">
        <text>✕</text>
      </view>
    </view>
    <scroll-view class="bs-body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <slot></slot>
    </scroll-view>
    <view class="bs-footer" wx:if="{{showFooter}}">
      <slot name="footer"></slot>
    </view>
  </view>
</view>
