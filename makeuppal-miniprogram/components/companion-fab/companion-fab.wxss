/* components/companion-fab/companion-fab.wxss */
.companion-fab {
  position: fixed;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD1DC, #FF8FA3);
  box-shadow: 0 6px 18px rgba(255, 143, 163, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  overflow: visible;
  transition: transform var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease);
}

.companion-fab-hover {
  transform: scale(0.92);
  box-shadow: 0 4px 12px rgba(255, 143, 163, 0.35);
}

.companion-fab-icon {
  font-size: 26px;
  line-height: 1;
  position: relative;
  z-index: 2;
}

/* 脉冲动画环 */
.companion-fab-pulse {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 143, 163, 0.35);
  z-index: 1;
  animation: fabPulse 2.4s ease-out infinite;
}

@keyframes fabPulse {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  70% {
    transform: scale(1.6);
    opacity: 0;
  }
  100% {
    transform: scale(1.6);
    opacity: 0;
  }
}
