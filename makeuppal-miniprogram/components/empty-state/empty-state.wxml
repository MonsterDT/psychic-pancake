<!-- components/empty-state/empty-state.wxml -->
<view class="empty-state">
  <view class="empty-icon">{{icon}}</view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc" wx:if="{{desc}}">{{desc}}</view>
  <view class="empty-action" wx:if="{{actionText}}" bindtap="onAction" hover-class="empty-action-hover" hover-stay-time="100">
    <text>{{actionText}}</text>
  </view>
</view>
