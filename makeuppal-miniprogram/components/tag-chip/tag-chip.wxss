/* components/tag-chip/tag-chip.wxss */
.tag-chip {
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius-full);
  font-weight: var(--font-weight-medium);
  line-height: 1;
  white-space: nowrap;
  vertical-align: middle;
}

.tag-chip-text {
  line-height: 1.2;
}

.tag-chip-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 4px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.12);
}

.tag-chip-close-icon {
  font-size: 9px;
  color: #fff;
  line-height: 1;
}

/* 尺寸 sm */
.tag-chip--sm {
  padding: 2px 8px;
  font-size: var(--font-size-xs);
}

/* 尺寸 md */
.tag-chip--md {
  padding: 4px 12px;
  font-size: var(--font-size-sm);
}

/* 类型 default */
.tag-chip--default {
  background: var(--color-bg-alt);
  color: var(--color-text-secondary);
}

/* 类型 primary */
.tag-chip--primary {
  background: rgba(196, 149, 106, 0.12);
  color: var(--color-primary);
}

/* 类型 danger */
.tag-chip--danger {
  background: rgba(196, 92, 92, 0.12);
  color: var(--color-danger);
}

/* 类型 success */
.tag-chip--success {
  background: rgba(107, 158, 107, 0.12);
  color: var(--color-success);
}

/* 类型 warning */
.tag-chip--warning {
  background: rgba(212, 160, 60, 0.14);
  color: var(--color-warning);
}
