/* components/image-safe/image-safe.wxss */
.image-safe {
  display: block;
  transition: opacity 0.3s ease;
  opacity: 0;
}

.image-safe.loaded {
  opacity: 1;
}

.image-safe.failed {
  display: none;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-alt);
  border-radius: var(--radius-md);
  width: 100%;
  height: 100%;
}

.placeholder-emoji {
  font-size: 32px;
  margin-bottom: 4px;
}

.placeholder-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}
