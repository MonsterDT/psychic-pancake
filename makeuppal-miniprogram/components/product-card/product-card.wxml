<!-- components/product-card/product-card.wxml -->
<view class="product-card" bindtap="onTap" hover-class="product-card-hover" hover-stay-time="100">
  <view class="product-img-wrap">
    <image-safe
      wx:if="{{img}}"
      class="product-img"
      src="{{img}}"
      mode="aspectFill"
      width="100%"
      height="100%"
      placeholderText="商品图加载中"
    ></image-safe>
    <view wx:else class="product-img-placeholder">
      <text class="product-img-placeholder-icon">🛍️</text>
    </view>
    <view wx:if="{{tag}}" class="product-tag">
      <text>{{tag}}</text>
    </view>
  </view>

  <view class="product-info">
    <view class="product-name ellipsis-2">{{name}}</view>
    <view class="product-brand" wx:if="{{brand}}">{{brand}}</view>
    <view class="product-desc ellipsis" wx:if="{{desc}}">{{desc}}</view>
    <view class="product-bottom">
      <view class="product-price-wrap">
        <price-tag price="{{price}}" original-price="{{originalPrice}}" size="md"></price-tag>
      </view>
      <view class="product-meta">
        <text class="product-sales" wx:if="{{salesText}}">{{salesText}}</text>
        <view class="product-addcart" catchtap="onAddCart" hover-class="product-addcart-hover" hover-stay-time="100">
          <text class="product-addcart-icon">🛒</text>
        </view>
      </view>
    </view>
  </view>
</view>
