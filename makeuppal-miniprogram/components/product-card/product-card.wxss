/* components/product-card/product-card.wxss */
.product-card {
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease);
}

.product-card-hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* 商品图 */
.product-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%; /* 1:1 正方形 */
  background: var(--color-bg-alt);
  overflow: hidden;
}

.product-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-img-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-alt);
}

.product-img-placeholder-icon {
  font-size: 40px;
  opacity: 0.6;
}

/* 角标 */
.product-tag {
  position: absolute;
  top: 8px;
  left: 8px;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--color-danger), #E87070);
  color: #fff;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  line-height: 1.3;
  box-shadow: 0 2px 6px rgba(196, 92, 92, 0.3);
}

/* 商品信息 */
.product-info {
  padding: var(--spacing-2) var(--spacing-3) var(--spacing-3);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  line-height: 1.4;
  min-height: 20px;
}

.product-brand {
  margin-top: 4px;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  line-height: 1.3;
}

.product-desc {
  margin-top: 2px;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.product-bottom {
  margin-top: auto;
  padding-top: var(--spacing-2);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-2);
}

.product-price-wrap {
  flex: 1;
  min-width: 0;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
  flex-shrink: 0;
}

.product-sales {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  line-height: 1;
}

.product-addcart {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 8px rgba(196, 149, 106, 0.35);
  transition: transform var(--duration-fast) var(--ease);
}

.product-addcart-hover {
  transform: scale(0.9);
}

.product-addcart-icon {
  font-size: 15px;
  line-height: 1;
}
