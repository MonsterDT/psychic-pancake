/* components/price-tag/price-tag.wxss */
.price-tag {
  display: inline-flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
}

.price-current {
  display: inline-flex;
  align-items: baseline;
  color: var(--color-danger);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
}

.price-unit {
  font-weight: var(--font-weight-semibold);
}

.price-original {
  display: inline-flex;
  align-items: baseline;
  color: var(--color-text-muted);
  text-decoration: line-through;
  font-weight: var(--font-weight-normal);
}

.price-original-unit {
  font-size: 0.85em;
}

/* 尺寸 sm */
.price-tag--sm .price-unit { font-size: 11px; }
.price-tag--sm .price-value { font-size: var(--font-size-base); }
.price-tag--sm .price-original-value { font-size: var(--font-size-xs); }

/* 尺寸 md */
.price-tag--md .price-unit { font-size: 12px; }
.price-tag--md .price-value { font-size: var(--font-size-xl); }
.price-tag--md .price-original-value { font-size: var(--font-size-sm); }

/* 尺寸 lg */
.price-tag--lg .price-unit { font-size: var(--font-size-base); }
.price-tag--lg .price-value { font-size: var(--font-size-2xl); }
.price-tag--lg .price-original-value { font-size: var(--font-size-base); }
