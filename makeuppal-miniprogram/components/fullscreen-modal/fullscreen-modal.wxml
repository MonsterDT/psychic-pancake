<!-- components/fullscreen-modal/fullscreen-modal.wxml -->
<view wx:if="{{visible}}" class="fm-overlay {{closing ? 'fm-closing' : ''}}" catchtouchmove="noop">
  <view class="fm-container {{closing ? 'fm-closing' : ''}}">
    <view class="fm-header" style="padding-top:{{safeTop}}px;">
      <view class="fm-header-bar">
        <view class="fm-header-title">{{title}}</view>
        <view class="fm-close" bindtap="onClose" hover-class="fm-close-hover" hover-stay-time="100">
          <text class="fm-close-icon">✕</text>
        </view>
      </view>
    </view>
    <scroll-view class="fm-body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <slot></slot>
    </scroll-view>
    <view class="fm-footer" wx:if="{{false}}">
      <slot name="footer"></slot>
    </view>
  </view>
</view>
