/* components/fullscreen-modal/fullscreen-modal.wxss */
.fm-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg);
  z-index: 300;
  animation: fmFadeIn 0.25s ease-out;
}

.fm-overlay.fm-closing {
  animation: fmFadeOut 0.25s ease-out forwards;
}

.fm-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  animation: fmSlideInRight 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.fm-container.fm-closing {
  animation: fmSlideOutRight 0.25s ease-in forwards;
}

.fm-header {
  position: relative;
  flex-shrink: 0;
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border-light);
  z-index: 2;
}

.fm-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 var(--spacing-4);
}

.fm-header-title {
  flex: 1;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fm-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background var(--duration-fast) var(--ease);
}

.fm-close-hover {
  background: var(--color-bg-alt);
}

.fm-close-icon {
  font-size: 16px;
  color: var(--color-text-muted);
  line-height: 1;
}

.fm-body {
  flex: 1;
  min-height: 0;
  padding: var(--spacing-4);
  box-sizing: border-box;
}

.fm-footer {
  flex-shrink: 0;
  padding: var(--spacing-3) var(--spacing-4);
  padding-bottom: calc(var(--spacing-3) + var(--safe-bottom));
  border-top: 1px solid var(--color-border-light);
  background: var(--color-bg-card);
}

@keyframes fmFadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fmFadeOut { from { opacity: 1; } to { opacity: 0; } }
@keyframes fmSlideInRight { from { transform: translateX(100%); } to { transform: translateX(0); } }
@keyframes fmSlideOutRight { from { transform: translateX(0); } to { transform: translateX(100%); } }
