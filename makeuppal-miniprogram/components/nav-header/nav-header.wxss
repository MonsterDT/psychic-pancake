/* components/nav-header/nav-header.wxss */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--color-bg);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 44px;
  padding: 0 12px;
  position: relative;
}

.nav-left, .nav-right {
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left-placeholder, .nav-right-placeholder {
  min-width: 44px;
}

.nav-back-icon {
  font-size: 32px;
  font-weight: 300;
  color: var(--color-text);
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right-text {
  font-size: var(--font-size-base);
  color: var(--color-primary);
}

.nav-right-icon {
  font-size: 22px;
}

.nav-placeholder {
  width: 100%;
}
