<!-- components/nav-header/nav-header.wxml -->
<view class="nav-header" style="padding-top:{{safeTop}}px;">
  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack" wx:if="{{showBack}}">
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="nav-left-placeholder" wx:else></view>
    <text class="nav-title">{{title}}</text>
    <view class="nav-right" bindtap="onRight" wx:if="{{rightText || rightIcon}}">
      <text class="nav-right-text">{{rightText}}</text>
      <text class="nav-right-icon">{{rightIcon}}</text>
    </view>
    <view class="nav-right-placeholder" wx:else></view>
  </view>
</view>
<view class="nav-placeholder" style="height:{{navHeight}}px;"></view>
