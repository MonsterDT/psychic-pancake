<!-- packageA/pages/cart/cart.wxml -->
<view class="cart-page">
  <!-- 空状态 -->
  <empty-state
    wx:if="{{isEmpty}}"
    icon="🛒"
    title="购物车空空如也"
    desc="快去市集挑选心仪的美妆好物吧"
    action-text="去逛逛"
    bind:action="goShopping"
  ></empty-state>

  <!-- 购物车列表 -->
  <block wx:if="{{!isEmpty}}">
    <scroll-view class="cart-scroll" scroll-y="true">
      <view class="cart-list">
        <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
          <!-- 单选 -->
          <view
            class="check-box {{item.checked ? 'checked' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleItem"
          >
            <text class="check-icon" wx:if="{{item.checked}}">✓</text>
          </view>
          <!-- 商品图 -->
          <image-safe class="item-img" src="{{item.img}}" mode="aspectFill" width="80px" height="80px"></image-safe>
          <!-- 商品信息 -->
          <view class="item-info">
            <view class="item-name ellipsis-2">{{item.name}}</view>
            <view class="item-brand">{{item.brand}}</view>
            <view class="item-bottom">
              <view class="item-price">¥{{item.price}}</view>
              <view class="qty-control">
                <view class="qty-btn" data-id="{{item.id}}" bindtap="decQty">-</view>
                <view class="qty-num">{{item.qty}}</view>
                <view class="qty-btn" data-id="{{item.id}}" bindtap="incQty">+</view>
              </view>
            </view>
          </view>
          <!-- 删除 -->
          <view class="item-delete" data-id="{{item.id}}" bindtap="onSwipeDelete">删除</view>
        </view>
      </view>
      <view class="bottom-placeholder"></view>
    </scroll-view>

    <!-- 底部结算栏 -->
    <view class="checkout-bar">
      <view class="all-check" bindtap="toggleAll">
        <view class="check-box {{allChecked ? 'checked' : ''}}">
          <text class="check-icon" wx:if="{{allChecked}}">✓</text>
        </view>
        <text class="all-check-text">全选</text>
      </view>
      <view class="total-wrap">
        <text class="total-label">合计：</text>
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
      <view class="checkout-btn {{totalCount === 0 ? 'disabled' : ''}}" bindtap="onCheckout">去结算({{totalCount}})</view>
    </view>
  </block>
</view>
