<!-- packageA/pages/favorites/favorites.wxml -->
<view class="fav-page">
  <!-- 空状态 -->
  <empty-state
    wx:if="{{isEmpty}}"
    icon="💝"
    title="还没有收藏模板"
    desc="去颜库发现更多好看的妆容模板，收藏喜欢的吧"
    action-text="去颜库逛逛"
    bind:action="goLibrary"
  ></empty-state>

  <!-- 收藏列表 -->
  <block wx:if="{{!isEmpty}}">
    <scroll-view class="fav-scroll" scroll-y="true">
      <view class="fav-list">
        <view class="fav-card" wx:for="{{favorites}}" wx:key="id" data-id="{{item.id}}" bindtap="openTemplate">
          <view class="fav-cover">
            <image-safe src="{{item.image}}" mode="aspectFill" width="100%" height="100%" placeholder-text="模板图加载中"></image-safe>
            <view class="fav-difficulty">{{item.difficulty}}星难度</view>
          </view>
          <view class="fav-info">
            <view class="fav-name">{{item.name}}</view>
            <view class="fav-desc ellipsis-2">{{item.desc}}</view>
            <view class="fav-meta">
              <view class="fav-tags">
                <text class="fav-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
              </view>
              <text class="fav-likes">♥ {{item.likes}}</text>
            </view>
          </view>
          <view class="fav-cancel" data-id="{{item.id}}" catchtap="removeFavorite">取消收藏</view>
        </view>
      </view>
      <view class="bottom-placeholder"></view>
    </scroll-view>
  </block>
</view>
