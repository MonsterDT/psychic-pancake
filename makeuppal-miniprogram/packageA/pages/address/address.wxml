<!-- packageA/pages/address/address.wxml -->
<view class="address-page">
  <!-- 空状态 -->
  <empty-state
    wx:if="{{isEmpty}}"
    icon="📍"
    title="还没有收货地址"
    desc="新增一个收货地址，方便下单购物"
    action-text="新增地址"
    bind:action="onAdd"
  ></empty-state>

  <!-- 地址列表 -->
  <block wx:if="{{!isEmpty}}">
    <scroll-view class="addr-scroll" scroll-y="true">
      <view class="addr-list">
        <view class="addr-card" wx:for="{{addresses}}" wx:key="id">
          <view class="addr-content">
            <view class="addr-head">
              <text class="addr-name">{{item.name}}</text>
              <text class="addr-phone">{{item.phone}}</text>
              <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
            </view>
            <view class="addr-detail">{{item.region}} {{item.detail}}</view>
          </view>
          <view class="addr-actions">
            <view class="addr-action" wx:if="{{!item.isDefault}}" data-id="{{item.id}}" bindtap="setDefault">
              <text>设为默认</text>
            </view>
            <view class="addr-action" data-id="{{item.id}}" bindtap="onEdit">
              <text>编辑</text>
            </view>
            <view class="addr-action danger" data-id="{{item.id}}" bindtap="onDelete">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
      <view class="bottom-placeholder"></view>
    </scroll-view>
  </block>

  <!-- 底部新增按钮 -->
  <view class="add-bar">
    <view class="add-btn" bindtap="onAdd" hover-class="btn-hover" hover-stay-time="100">+ 新增收货地址</view>
  </view>
</view>
