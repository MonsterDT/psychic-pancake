<!-- packageA/pages/address-edit/address-edit.wxml -->
<view class="edit-page">
  <view class="form-card">
    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入收货人姓名"
        value="{{form.name}}"
        bindinput="onNameInput"
        maxlength="20"
      ></input>
    </view>
    <!-- 电话 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号码"
        value="{{form.phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      ></input>
    </view>
    <!-- 省市区 -->
    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
        <view class="form-picker {{form.region.length > 0 ? 'filled' : ''}}">
          <text>{{regionText}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <!-- 详细地址 -->
    <view class="form-item form-item-textarea">
      <text class="form-label">详细地址</text>
      <textarea
        class="form-textarea"
        placeholder="请输入详细地址，如街道、楼牌号等"
        value="{{form.detail}}"
        bindinput="onDetailInput"
        maxlength="100"
        auto-height
      ></textarea>
    </view>
    <!-- 设为默认 -->
    <view class="form-item form-item-switch">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#C4956A"></switch>
    </view>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 保存按钮 -->
  <view class="save-bar">
    <view class="save-btn" bindtap="onSave" hover-class="btn-hover" hover-stay-time="100">保存地址</view>
  </view>
</view>
