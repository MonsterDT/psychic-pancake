/* packageA/pages/order-detail/order-detail.wxss */
.od-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: var(--spacing-3);
}

/* 步骤条 */
.steps-card {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-3);
}

.status-banner {
  margin-bottom: var(--spacing-4);
}

.status-label {
  font-size: var(--font-size-xl);
  color: #fff;
  font-weight: var(--font-weight-bold);
}

.steps {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-dot {
  width: 24px;
  height: 24px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.4);
  color: #fff;
  font-size: var(--font-size-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.step.done .step-dot {
  background: #fff;
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.step-line {
  position: absolute;
  top: 12px;
  left: 50%;
  width: 100%;
  height: 2px;
  background: rgba(255, 255, 255, 0.4);
  z-index: 1;
}

.step.done .step-line {
  background: #fff;
}

.step-label {
  margin-top: 6px;
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.step.done .step-label {
  color: #fff;
  font-weight: var(--font-weight-medium);
}

/* 地址卡片 */
.address-card {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-3);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-4);
  margin: 0 var(--spacing-3) var(--spacing-3);
}

.addr-icon {
  font-size: 20px;
  flex-shrink: 0;
}

.addr-info {
  flex: 1;
}

.addr-head {
  display: flex;
  gap: var(--spacing-3);
  margin-bottom: 6px;
}

.addr-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.addr-phone {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.addr-detail {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 通用卡片 */
.goods-card,
.fee-card,
.info-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-4);
  margin: 0 var(--spacing-3) var(--spacing-3);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: var(--spacing-3);
  padding-bottom: var(--spacing-2);
  border-bottom: 1px solid var(--color-border-light);
}

/* 商品列表 */
.goods-item {
  display: flex;
  gap: var(--spacing-3);
  padding: var(--spacing-2) 0;
}

.goods-img {
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: var(--font-size-base);
  color: var(--color-text);
  line-height: 1.4;
}

.goods-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price {
  font-size: var(--font-size-base);
  color: var(--color-danger);
  font-weight: var(--font-weight-medium);
}

.goods-qty {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* 费用明细 */
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  font-size: var(--font-size-base);
}

.fee-label {
  color: var(--color-text-secondary);
}

.fee-value {
  color: var(--color-text);
}

.fee-value.discount {
  color: var(--color-danger);
}

.fee-row.total {
  margin-top: var(--spacing-2);
  padding-top: var(--spacing-2);
  border-top: 1px solid var(--color-border-light);
}

.total-value {
  font-size: var(--font-size-lg);
  color: var(--color-danger);
  font-weight: var(--font-weight-bold);
}

/* 订单信息 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  font-size: var(--font-size-sm);
}

.info-label {
  color: var(--color-text-muted);
}

.info-value {
  color: var(--color-text-secondary);
}

/* 底部操作栏 */
.bottom-placeholder {
  height: 72px;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--safe-bottom);
  z-index: 120;
  display: flex;
  gap: var(--spacing-3);
  padding: var(--spacing-3) var(--spacing-4);
  background: var(--color-bg-card);
  box-shadow: 0 -2px 12px rgba(45, 42, 38, 0.08);
}

.action-btn {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  transition: all var(--duration-fast) var(--ease);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 4px 12px rgba(196, 149, 106, 0.3);
}

.action-btn.outline {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
}
