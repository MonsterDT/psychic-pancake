<!-- packageA/pages/product-detail/product-detail.wxml -->
<view class="detail-page" wx:if="{{product}}">
  <!-- 商品大图轮播 -->
  <view class="gallery-wrap">
    <swiper class="gallery-swiper" circular="{{true}}" autoplay="{{false}}" indicator-dots="{{false}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{gallery}}" wx:key="*this">
        <image-safe src="{{item}}" mode="aspectFill" width="100%" height="100%" placeholder-text="商品图加载中"></image-safe>
      </swiper-item>
    </swiper>
    <view class="gallery-index">{{currentImgIndex + 1}}/{{gallery.length}}</view>
  </view>

  <!-- 价格与基本信息 -->
  <view class="info-card">
    <view class="price-row">
      <price-tag price="{{product.price}}" original-price="{{product.originalPrice}}" size="lg"></price-tag>
    </view>
    <view class="product-name">{{product.name}}</view>
    <view class="product-meta">
      <text class="meta-brand">{{product.brand}}</text>
      <text class="meta-rating">★ {{ratingText}}</text>
      <text class="meta-sales" wx:if="{{product.sales}}">销量 {{product.sales}}</text>
    </view>
    <view class="product-desc" wx:if="{{product.description}}">{{product.description}}</view>
    <view class="product-desc" wx:elif="{{product.desc}}">{{product.desc}}</view>
  </view>

  <!-- 规格选择 -->
  <view class="spec-card" wx:if="{{specs.length > 0}}">
    <view class="spec-group" wx:for="{{specs}}" wx:key="name" wx:for-item="spec" wx:for-index="sIdx">
      <view class="spec-title">{{spec.name}}</view>
      <view class="spec-options">
        <view
          class="spec-option {{spec.selectedIdx === oIdx ? 'active' : ''}}"
          wx:for="{{spec.options}}"
          wx:key="*this"
          wx:for-item="opt"
          wx:for-index="oIdx"
          data-spec-idx="{{sIdx}}"
          data-option-idx="{{oIdx}}"
          bindtap="selectSpec"
        >{{opt}}</view>
      </view>
    </view>
    <view class="spec-group">
      <view class="spec-title">数量</view>
      <view class="qty-control">
        <view class="qty-btn {{qty <= 1 ? 'disabled' : ''}}" bindtap="decQty">-</view>
        <view class="qty-num">{{qty}}</view>
        <view class="qty-btn" bindtap="incQty">+</view>
      </view>
    </view>
  </view>

  <!-- 评价区 -->
  <view class="review-card">
    <view class="section-header-inline">
      <text class="section-title-inline">用户评价</text>
      <text class="section-count">{{reviews.length}}条</text>
    </view>
    <view class="review-list">
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <image-safe class="review-avatar" src="{{item.avatar}}" mode="aspectFill" width="36px" height="36px"></image-safe>
        <view class="review-body">
          <view class="review-head">
            <text class="review-name">{{item.name}}</text>
            <text class="review-stars">★ {{item.rating}}.0</text>
          </view>
          <view class="review-content">{{item.content}}</view>
          <view class="review-date">{{item.date}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位，避免被固定栏遮挡 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部固定操作栏 -->
  <view class="action-bar">
    <view class="action-btn action-btn-cart" bindtap="onAddCart" hover-class="btn-hover" hover-stay-time="100">加入购物车</view>
    <view class="action-btn action-btn-buy" bindtap="onBuyNow" hover-class="btn-hover" hover-stay-time="100">立即购买</view>
  </view>
</view>
