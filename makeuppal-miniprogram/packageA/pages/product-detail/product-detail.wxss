/* packageA/pages/product-detail/product-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 轮播图 */
.gallery-wrap {
  position: relative;
  width: 100%;
  height: 420px;
  background: var(--color-bg-alt);
}

.gallery-swiper {
  width: 100%;
  height: 100%;
}

.gallery-index {
  position: absolute;
  right: var(--spacing-3);
  bottom: var(--spacing-3);
  padding: 2px 10px;
  border-radius: var(--radius-full);
  background: rgba(45, 42, 38, 0.5);
  color: #fff;
  font-size: var(--font-size-xs);
}

/* 信息卡片 */
.info-card {
  background: var(--color-bg-card);
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-3);
}

.price-row {
  margin-bottom: var(--spacing-2);
}

.product-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: var(--spacing-2);
}

.product-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-3);
}

.meta-brand {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.meta-rating {
  color: var(--color-warning);
}

.product-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 规格卡片 */
.spec-card {
  background: var(--color-bg-card);
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-3);
}

.spec-group {
  padding: var(--spacing-2) 0;
  border-bottom: 1px solid var(--color-border-light);
}

.spec-group:last-child {
  border-bottom: none;
}

.spec-title {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--spacing-2);
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-2);
}

.spec-option {
  padding: 6px 16px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  transition: all var(--duration-fast) var(--ease);
}

.spec-option.active {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: rgba(196, 149, 106, 0.08);
}

/* 数量控制 */
.qty-control {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.qty-btn {
  width: 36px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-lg);
  color: var(--color-text);
  background: var(--color-bg-card);
}

.qty-btn.disabled {
  color: var(--color-text-muted);
}

.qty-num {
  min-width: 44px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base);
  border-left: 1px solid var(--color-border-light);
  border-right: 1px solid var(--color-border-light);
}

/* 评价区 */
.review-card {
  background: var(--color-bg-card);
  padding: var(--spacing-4);
  margin-bottom: var(--spacing-3);
}

.section-header-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-3);
}

.section-title-inline {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.section-count {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.review-item {
  display: flex;
  gap: var(--spacing-2);
  padding: var(--spacing-3) 0;
  border-bottom: 1px solid var(--color-border-light);
}

.review-item:last-child {
  border-bottom: none;
}

.review-avatar {
  border-radius: var(--radius-full);
  overflow: hidden;
  flex-shrink: 0;
}

.review-body {
  flex: 1;
  min-width: 0;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}

.review-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
}

.review-stars {
  font-size: var(--font-size-xs);
  color: var(--color-warning);
}

.review-content {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: 4px;
}

.review-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 底部固定栏 */
.bottom-placeholder {
  height: 72px;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--safe-bottom);
  z-index: 110;
  display: flex;
  gap: var(--spacing-3);
  padding: var(--spacing-3) var(--spacing-4);
  background: var(--color-bg-card);
  box-shadow: 0 -2px 12px rgba(45, 42, 38, 0.08);
}

.action-btn {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  transition: all var(--duration-fast) var(--ease);
}

.action-btn-cart {
  background: rgba(196, 149, 106, 0.12);
  color: var(--color-primary);
}

.action-btn-buy {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 4px 12px rgba(196, 149, 106, 0.3);
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}
