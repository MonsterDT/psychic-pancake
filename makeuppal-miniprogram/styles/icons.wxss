/* ===== 金刚位图标（大号emoji） ===== */
.kingkong-icon {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  margin: 0 auto var(--spacing-2);
  background: var(--color-bg-alt);
}

.kingkong-icon.mirror { background: linear-gradient(135deg, #FFE5D9, #FFCDB2); }
.kingkong-icon.library { background: linear-gradient(135deg, #F4DDBB, #E8C9A8); }
.kingkong-icon.mall { background: linear-gradient(135deg, #FFD8C4, #FFB997); }
.kingkong-icon.scan { background: linear-gradient(135deg, #D5E8D4, #B8E0C8); }
.kingkong-icon.creator { background: linear-gradient(135deg, #FFE5F0, #FFC9DD); }

/* ===== 功能区图标（我的页面） ===== */
.feature-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin: 0 auto var(--spacing-2);
  background: var(--color-bg-alt);
}

/* ===== 订单状态图标 ===== */
.order-status-icon {
  font-size: 24px;
  display: block;
  text-align: center;
  margin-bottom: 4px;
}

/* ===== 标签图标 ===== */
.tag-icon {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
}

.tag-icon.hot { background: rgba(196,92,92,0.1); color: var(--color-danger); }
.tag-icon.new { background: rgba(91,142,196,0.1); color: var(--color-info); }
.tag-icon.special { background: rgba(212,160,60,0.1); color: var(--color-warning); }
