/* styles/icons.wxss - 图标样式（emoji + CSS图标，替代内联SVG） */

/* ===== 图标基础类 ===== */
.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  font-size: 20px;
  line-height: 1;
}

.icon-sm { width: 18px; height: 18px; font-size: 15px; }
.icon-lg { width: 32px; height: 32px; font-size: 26px; }
.icon-xl { width: 48px; height: 48px; font-size: 40px; }

/* ===== 导航图标 ===== */
.icon-arrow-right::before { content: "›"; font-size: 28px; font-weight: 300; color: var(--color-text-muted); }
.icon-arrow-left::before { content: "‹"; font-size: 28px; font-weight: 300; color: var(--color-text); }
.icon-arrow-up::before { content: "⌃"; font-size: 22px; color: var(--color-text-muted); }
.icon-arrow-down::before { content: "⌄"; font-size: 22px; color: var(--color-text-muted); }

/* ===== 操作图标 ===== */
.icon-close::before { content: "✕"; font-size: 18px; color: var(--color-text-secondary); }
.icon-check::before { content: "✓"; font-size: 18px; color: var(--color-success); }
.icon-plus::before { content: "+"; font-size: 22px; font-weight: 300; color: var(--color-text-secondary); }
.icon-minus::before { content: "−"; font-size: 22px; font-weight: 300; color: var(--color-text-secondary); }

/* ===== 功能图标（emoji） ===== */
.icon-home::before { content: "🏠"; }
.icon-library::before { content: "💄"; }
.icon-mirror::before { content: "🪞"; }
.icon-mall::before { content: "🛍️"; }
