/* styles/animations.wxss - 动画样式 */

/* ===== 淡入淡出 ===== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.anim-fade-in { animation: fadeIn 0.3s ease-out forwards; }
.anim-fade-out { animation: fadeOut 0.3s ease-out forwards; }

/* ===== 滑入滑出 ===== */
@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes slideDown {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(100%); opacity: 0; }
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

@keyframes slideInLeft {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.anim-slide-up { animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
.anim-slide-down { animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
.anim-slide-in-right { animation: slideInRight 0.3s ease-out forwards; }
.anim-slide-in-left { animation: slideInLeft 0.3s ease-out forwards; }

/* ===== 缩放 ===== */
@keyframes scaleIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes scaleOut {
  from { transform: scale(1); opacity: 1; }
  to { transform: scale(0.8); opacity: 0; }
}

.anim-scale-in { animation: scaleIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
.anim-scale-out { animation: scaleOut 0.2s ease-in forwards; }

/* ===== 脉冲（喜欢按钮） ===== */
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.anim-pulse { animation: pulse 0.4s ease-out; }

/* ===== 心跳 ===== */
@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.1); }
  50% { transform: scale(1); }
  75% { transform: scale(1.05); }
}

.anim-heartbeat { animation: heartbeat 1.5s ease-in-out infinite; }

/* ===== 旋转（加载） ===== */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.anim-spin { animation: spin 0.8s linear infinite; }

/* ===== 弹跳 ===== */
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.anim-bounce { animation: bounce 0.6s ease-in-out infinite; }

/* ===== 闪烁 ===== */
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.anim-blink { animation: blink 1.2s ease-in-out infinite; }

/* ===== 卡片滑动（Tinder风格） ===== */
@keyframes cardSwipeRight {
  from { transform: translateX(0) rotate(0deg); opacity: 1; }
  to { transform: translateX(150%) rotate(30deg); opacity: 0; }
}

@keyframes cardSwipeLeft {
  from { transform: translateX(0) rotate(0deg); opacity: 1; }
  to { transform: translateX(-150%) rotate(-30deg); opacity: 0; }
}

.anim-swipe-right { animation: cardSwipeRight 0.4s ease-in forwards; }
.anim-swipe-left { animation: cardSwipeLeft 0.4s ease-in forwards; }

/* ===== 弹簧 ===== */
@keyframes spring {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.anim-spring { animation: spring 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

/* ===== 浮动 ===== */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

.anim-float { animation: float 2s ease-in-out infinite; }

/* ===== 光效（闪光） ===== */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.anim-shimmer {
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* ===== 过渡类（用于状态切换） ===== */
.transition-all { transition: all 0.3s ease; }
.transition-transform { transition: transform 0.3s ease; }
.transition-opacity { transition: opacity 0.3s ease; }
.transition-colors { transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease; }

/* ===== 弹窗遮罩 ===== */
.overlay-enter {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.overlay-enter-active {
  opacity: 1;
}

.overlay-exit {
  opacity: 1;
  transition: opacity 0.3s ease;
}

.overlay-exit-active {
  opacity: 0;
}
