<!--custom-tab-bar/index.wxml - 自定义底部导航栏-->
<view class="custom-tab-bar">
  <view
    class="tab-item {{index === 2 ? 'tab-center-wrap' : ''}}"
    wx:for="{{list}}"
    wx:key="key"
    data-key="{{item.key}}"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="tab-hover"
  >
    <!-- 中间焕新按钮：圆角矩形凸起 -->
    <view wx:if="{{index === 2}}" class="tab-center-btn {{selected === index ? 'active' : ''}}">
      <text class="tab-center-icon">{{item.icon}}</text>
      <text class="tab-center-text">{{item.text}}</text>
    </view>
    <!-- 普通tab按钮 -->
    <view wx:else class="tab-normal {{selected === index ? 'active' : ''}}">
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
