/* packageB/pages/toolbox/toolbox.wxss */
.page-toolbox {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 顶部说明 */
.intro-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(196, 149, 106, 0.25);
}

.intro-icon {
  font-size: 64rpx;
}

.intro-info {
  flex: 1;
}

.intro-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 8rpx;
}

.intro-desc {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
}

/* 工具网格 */
.tools-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.tool-card {
  padding: 28rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  transition: transform var(--duration-fast) var(--ease);
}

.tool-card:active {
  transform: scale(0.97);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.tool-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.tool-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: var(--z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.modal-box {
  width: 100%;
  max-width: 600rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  animation: modalIn var(--duration-normal) var(--ease);
}

@keyframes modalIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid var(--color-border-light);
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
}

.modal-body {
  padding: 32rpx;
}

.demo-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

/* 色号对比 */
.demo-shades {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  width: 100%;
}

.demo-shade {
  height: 120rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8rpx;
}

.demo-shade-name {
  font-size: var(--font-size-xs);
  color: #fff;
  font-weight: var(--font-weight-medium);
}

/* 输入框 */
.demo-input-row {
  width: 100%;
}

.demo-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background: var(--color-bg);
}

/* 肤质测试 */
.demo-question {
  width: 100%;
}

.demo-q-title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.demo-q-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.demo-q-opt {
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.demo-icon-large {
  font-size: 96rpx;
  margin: 16rpx 0;
}

.demo-tip {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.6;
}

.demo-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(196, 149, 106, 0.3);
}

.demo-btn:active {
  opacity: 0.85;
}

/* 季节推荐 */
.season-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.season-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.season-icon {
  font-size: 48rpx;
}

.season-info {
  flex: 1;
}

.season-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.season-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}
