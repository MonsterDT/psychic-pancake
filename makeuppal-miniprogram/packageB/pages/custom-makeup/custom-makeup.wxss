/* packageB/pages/custom-makeup/custom-makeup.wxss */
.page-custom-makeup {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 进度指示器 */
.progress-bar {
  position: relative;
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.progress-line {
  position: absolute;
  top: 48rpx;
  left: 80rpx;
  right: 80rpx;
  height: 4rpx;
  background: var(--color-border-light);
  z-index: 0;
}

.progress-line-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary));
  transition: width var(--duration-normal) var(--ease);
}

.progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.progress-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-step--active .progress-num {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-color: var(--color-primary);
  color: #fff;
}

.progress-step--done .progress-num {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.progress-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.progress-step--active .progress-label,
.progress-step--done .progress-label {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* 步骤内容 */
.step-content {
  margin-top: 16rpx;
}

.step-head {
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.step-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.step-subtitle {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

/* 选项列表 */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-xs);
  transition: all var(--duration-fast) var(--ease);
}

.option-card--selected {
  border-color: var(--color-primary);
  background: rgba(196, 149, 106, 0.05);
  box-shadow: 0 4rpx 12rpx rgba(196, 149, 106, 0.15);
}

.option-card:active {
  transform: scale(0.98);
}

.option-icon {
  font-size: 56rpx;
  width: 80rpx;
  text-align: center;
}

.option-info {
  flex: 1;
  min-width: 0;
}

.option-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.option-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 产品偏好 */
.pref-block {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.pref-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pref-icon {
  font-size: 36rpx;
}

.pref-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.pref-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pref-option {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  border: 2rpx solid transparent;
}

.pref-option--selected {
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.pref-option:active {
  opacity: 0.7;
}

/* 生成中 */
.generating {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.generating-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.15); opacity: 0.7; }
}

.generating-text {
  font-size: var(--font-size-lg);
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.generating-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  animation: bounce 1.2s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 方案结果 */
.plan-result {
  margin-top: 8rpx;
}

.plan-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.plan-cover-img {
  width: 100%;
  height: 100%;
}

.plan-cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
}

.plan-cover-title {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
}

.plan-name {
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 12rpx;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
}

.plan-tag {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: var(--font-size-xs);
}

.plan-section {
  margin-bottom: 28rpx;
}

.plan-section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.plan-summary {
  padding: 24rpx 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* 步骤 */
.plan-steps {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
}

.plan-step {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--color-border-light);
}

.plan-step:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.plan-step:first-child {
  padding-top: 0;
}

.plan-step-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-step-content {
  flex: 1;
  min-width: 0;
}

.plan-step-title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.plan-step-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 产品 */
.plan-products {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.plan-product {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xs);
}

.plan-product-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-alt);
}

.plan-product-img image {
  width: 100%;
  height: 100%;
}

.plan-product-info {
  flex: 1;
  min-width: 0;
}

.plan-product-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.plan-product-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 小贴士 */
.plan-tips {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.plan-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: rgba(212, 160, 60, 0.08);
  border-radius: var(--radius-md);
}

.plan-tip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.plan-tip-text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 操作按钮 */
.plan-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.plan-action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
}

.plan-action-btn--outline {
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
}

.plan-action-btn--primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(196, 149, 106, 0.3);
}

.plan-action-btn:active {
  opacity: 0.85;
}

/* 底部按钮 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet);
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom, 0px));
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(45, 42, 38, 0.08);
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
}

.footer-btn--outline {
  background: var(--color-bg-alt);
  color: var(--color-text-secondary);
}

.footer-btn--primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(196, 149, 106, 0.3);
}

.footer-btn:active {
  opacity: 0.85;
}
