<!-- packageB/pages/custom-makeup/custom-makeup.wxml -->
<view class="page-custom-makeup">
  <!-- 顶部进度指示器 -->
  <view class="progress-bar">
    <view class="progress-step {{currentStep >= index + 1 ? 'progress-step--active' : ''}} {{currentStep > index + 1 ? 'progress-step--done' : ''}}" wx:for="{{stepTitles}}" wx:key="index">
      <view class="progress-num">
        <text wx:if="{{currentStep > index + 1}}">✓</text>
        <text wx:else>{{index + 1}}</text>
      </view>
      <view class="progress-label">{{item}}</view>
    </view>
    <view class="progress-line">
      <view class="progress-line-fill" style="width: {{(currentStep - 1) / (totalSteps - 1) * 100}}%;"></view>
    </view>
  </view>

  <!-- 步骤1：选场景 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="step-head">
      <view class="step-title">选择使用场景</view>
      <view class="step-subtitle">你将在什么场合使用这个妆容？</view>
    </view>
    <view class="option-list">
      <view class="option-card {{selectedScene === item.id ? 'option-card--selected' : ''}}" wx:for="{{scenes}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectScene">
        <view class="option-icon">{{item.icon}}</view>
        <view class="option-info">
          <view class="option-name">{{item.name}}</view>
          <view class="option-desc">{{item.desc}}</view>
        </view>
        <view class="option-check" wx:if="{{selectedScene === item.id}}">
          <text>✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤2：选风格 -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <view class="step-head">
      <view class="step-title">选择妆容风格</view>
      <view class="step-subtitle">你想要什么样的整体感觉？</view>
    </view>
    <view class="option-list">
      <view class="option-card {{selectedStyle === item.id ? 'option-card--selected' : ''}}" wx:for="{{styles}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectStyle">
        <view class="option-icon">{{item.icon}}</view>
        <view class="option-info">
          <view class="option-name">{{item.name}}</view>
          <view class="option-desc">{{item.desc}}</view>
        </view>
        <view class="option-check" wx:if="{{selectedStyle === item.id}}">
          <text>✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤3：选产品 -->
  <view class="step-content" wx:if="{{currentStep === 3}}">
    <view class="step-head">
      <view class="step-title">选择产品偏好</view>
      <view class="step-subtitle">为底妆、眼妆、唇妆各选一种风格</view>
    </view>
    <view class="pref-block" wx:for="{{productPrefs}}" wx:key="id">
      <view class="pref-head">
        <text class="pref-icon">{{item.icon}}</text>
        <text class="pref-name">{{item.name}}</text>
      </view>
      <view class="pref-options">
        <view class="pref-option {{item.selected === opt ? 'pref-option--selected' : ''}}" wx:for="{{item.options}}" wx:for-item="opt" wx:key="*this" data-pref="{{item.id}}" data-option="{{opt}}" bindtap="onSelectProduct">
          <text>{{opt}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤4：生成方案 -->
  <view class="step-content" wx:if="{{currentStep === 4}}">
    <!-- 生成中 -->
    <view class="generating" wx:if="{{isGenerating}}">
      <view class="generating-icon">✨</view>
      <view class="generating-text">AI正在为你定制妆容方案...</view>
      <view class="generating-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>

    <!-- 生成结果 -->
    <view class="plan-result" wx:if="{{generatedPlan && !isGenerating}}">
      <!-- 方案封面 -->
      <view class="plan-cover">
        <image src="{{generatedPlan.coverImage}}" mode="aspectFill" class="plan-cover-img"></image>
        <view class="plan-cover-mask"></view>
        <view class="plan-cover-title">
          <view class="plan-name">{{generatedPlan.title}}</view>
          <view class="plan-tags">
            <view class="plan-tag">{{generatedPlan.scene}}</view>
            <view class="plan-tag">{{generatedPlan.style}}</view>
          </view>
        </view>
      </view>

      <!-- 方案摘要 -->
      <view class="plan-section">
        <view class="plan-section-title">方案概述</view>
        <view class="plan-summary">{{generatedPlan.summary}}</view>
      </view>

      <!-- 步骤 -->
      <view class="plan-section">
        <view class="plan-section-title">妆容步骤</view>
        <view class="plan-steps">
          <view class="plan-step" wx:for="{{generatedPlan.steps}}" wx:key="num">
            <view class="plan-step-num">{{item.num}}</view>
            <view class="plan-step-content">
              <view class="plan-step-title">{{item.title}}</view>
              <view class="plan-step-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 推荐产品 -->
      <view class="plan-section" wx:if="{{generatedPlan.products.length}}">
        <view class="plan-section-title">推荐产品</view>
        <view class="plan-products">
          <view class="plan-product" wx:for="{{generatedPlan.products}}" wx:key="name">
            <view class="plan-product-img">
              <image src="{{item.img}}" mode="aspectFill"></image>
            </view>
            <view class="plan-product-info">
              <view class="plan-product-name ellipsis">{{item.name}}</view>
              <view class="plan-product-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 小贴士 -->
      <view class="plan-section" wx:if="{{generatedPlan.tips.length}}">
        <view class="plan-section-title">小贴士</view>
        <view class="plan-tips">
          <view class="plan-tip" wx:for="{{generatedPlan.tips}}" wx:key="index">
            <text class="plan-tip-icon">💡</text>
            <text class="plan-tip-text">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="plan-actions">
        <view class="plan-action-btn plan-action-btn--outline" bindtap="onRegenerate">
          <text>重新生成</text>
        </view>
        <view class="plan-action-btn plan-action-btn--outline" bindtap="onSavePlan">
          <text>保存方案</text>
        </view>
        <view class="plan-action-btn plan-action-btn--primary" bindtap="onTryNow">
          <text>立即试用</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-bar safe-bottom" wx:if="{{currentStep < 4 || !generatedPlan}}">
    <view class="footer-btn footer-btn--outline" wx:if="{{currentStep > 1 && currentStep < 4}}" bindtap="onPrevStep">
      <text>上一步</text>
    </view>
    <view class="footer-btn footer-btn--primary" wx:if="{{currentStep < 4}}" bindtap="onNextStep">
      <text>{{currentStep === 3 ? '生成方案' : '下一步'}}</text>
    </view>
  </view>
</view>
