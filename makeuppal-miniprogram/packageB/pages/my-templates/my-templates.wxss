/* packageB/pages/my-templates/my-templates.wxss */
.page-my-templates {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom, 0px));
}

/* 收藏网格 - 2列 */
.fav-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.fav-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease);
}

.fav-card:active {
  transform: scale(0.97);
}

.fav-cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.fav-cover-img {
  width: 100%;
  height: 100%;
}

.fav-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: var(--font-size-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-likes {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: var(--font-size-xs);
}

.fav-info {
  padding: 20rpx;
}

.fav-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.fav-author {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.fav-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.fav-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.fav-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
}

/* 空状态 */
.empty-wrap {
  padding-top: 120rpx;
}
