<!-- packageB/pages/my-reports/my-reports.wxml -->
<view class="page-my-reports">
  <!-- 顶部生成按钮 -->
  <view class="create-bar">
    <view class="create-info">
      <view class="create-title">智能肤质检测</view>
      <view class="create-desc">AI分析你的肤质、脸型与肤色</view>
    </view>
    <view class="create-btn" bindtap="onCreateReport">
      <text>立即检测</text>
    </view>
  </view>

  <!-- 报告列表 -->
  <view class="report-list" wx:if="{{!isEmpty}}">
    <view class="report-card" wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapReport">
      <view class="report-left">
        <view class="report-score" style="color: {{item.score >= 85 ? '#6B9E6B' : (item.score >= 75 ? '#C4956A' : '#D4A03C')}};">
          <text class="report-score-num">{{item.score}}</text>
          <text class="report-score-unit">分</text>
        </view>
        <view class="report-level">{{item.scoreLevel}}</view>
      </view>
      <view class="report-right">
        <view class="report-top">
          <view class="report-type">{{item.type}}</view>
          <view class="report-date">{{item.date}}</view>
        </view>
        <view class="report-summary ellipsis-2">{{item.summary}}</view>
        <view class="report-tags" wx:if="{{item.tags.length}}">
          <view class="report-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
            <text>{{tag}}</text>
          </view>
        </view>
      </view>
      <view class="report-arrow">
        <text>›</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{isEmpty}}">
    <view class="empty-icon">📋</view>
    <view class="empty-title">暂无检测报告</view>
    <view class="empty-desc">完成首次肤质检测后，报告将显示在此处</view>
  </view>
</view>
