/* packageB/pages/my-reports/my-reports.wxss */
.page-my-reports {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom, 0px));
}

/* 顶部生成栏 */
.create-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(196, 149, 106, 0.25);
}

.create-info {
  flex: 1;
}

.create-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 8rpx;
}

.create-desc {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
}

.create-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.95);
  color: var(--color-primary);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
}

.create-btn:active {
  opacity: 0.85;
}

/* 报告列表 */
.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-card {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  position: relative;
  transition: transform var(--duration-fast) var(--ease);
}

.report-card:active {
  transform: scale(0.98);
}

.report-left {
  flex-shrink: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1px solid var(--color-border-light);
  padding-right: 24rpx;
}

.report-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.report-score-num {
  font-size: 60rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.report-score-unit {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.report-level {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
}

.report-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.report-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.report-type {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.report-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.report-summary {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.report-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.report-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
}

.report-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: var(--color-text-muted);
  line-height: 1;
}

/* 空状态 */
.empty-wrap {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  text-align: center;
}
