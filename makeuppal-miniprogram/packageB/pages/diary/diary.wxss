/* packageB/pages/diary/diary.wxss */
.page-diary {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 日历头部 */
.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.cal-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--color-primary);
  line-height: 1;
}

.cal-nav:active {
  opacity: 0.6;
}

.cal-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

/* 日历卡片 */
.calendar-card {
  padding: 24rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 32rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 16rpx;
}

.week-cell {
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  padding: 8rpx 0;
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx 0;
}

.day-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  min-height: 72rpx;
  border-radius: var(--radius-md);
}

.day-empty {
  visibility: hidden;
}

.day-num {
  font-size: var(--font-size-base);
  color: var(--color-text);
  line-height: 1;
}

.day-today .day-num {
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.day-selected {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.day-selected .day-num {
  color: #fff;
  font-weight: var(--font-weight-semibold);
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--color-danger);
  margin-top: 6rpx;
}

.day-selected .day-dot {
  background: #fff;
}

.day-has-diary .day-dot {
  display: block;
}

/* 日记区 */
.diary-section {
  margin-top: 8rpx;
}

.diary-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.diary-date-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.add-diary-btn {
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.add-diary-btn:active {
  opacity: 0.7;
}

/* 日记卡片 */
.diary-card {
  padding: 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.diary-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.diary-makeup {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.diary-mood {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.diary-mood-icon {
  font-size: 36rpx;
}

.diary-mood-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.diary-photo {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 20rpx;
  background: var(--color-bg-alt);
}

.diary-photo-img {
  width: 100%;
  height: 100%;
}

.diary-note {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.diary-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.diary-duration {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.diary-meta-icon {
  font-size: 24rpx;
}

.diary-products {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1px solid var(--color-border-light);
}

.diary-products-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 40rpx;
}

.diary-product-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.diary-product-chip {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
}

/* 空状态 */
.diary-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.diary-empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.diary-empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  margin-bottom: 24rpx;
}

.diary-empty-btn {
  padding: 16rpx 40rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  box-shadow: 0 4rpx 12rpx rgba(196, 149, 106, 0.3);
}

.diary-empty-btn:active {
  opacity: 0.85;
}

.bottom-placeholder {
  height: 40rpx;
}
