/* packageB/pages/face-profile/face-profile.wxss */
.page-face-profile {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 用户头部 */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(196, 149, 106, 0.25);
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.profile-avatar image-safe {
  width: 100%;
  height: 100%;
}

.profile-name {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 16rpx;
}

.profile-tags-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.profile-tag {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: var(--font-size-xs);
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* 三维评分圆形进度条 */
.score-circles {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.score-circle-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.score-circle {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.score-circle-bg {
  position: absolute;
  inset: 0;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
}

.score-circle-progress {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-circle-inner {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-circle-val {
  font-size: 44rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  line-height: 1;
}

.score-circle-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  margin-top: 2rpx;
}

.score-circle-name {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

/* 六维数据 */
.dim-card {
  padding: 28rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.dim-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.dim-label {
  width: 160rpx;
  font-size: var(--font-size-base);
  color: var(--color-text);
  flex-shrink: 0;
}

.dim-bar {
  flex: 1;
  height: 20rpx;
  background: var(--color-bg-alt);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent), var(--color-primary));
  border-radius: var(--radius-full);
}

.dim-val {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 特征标签 */
.traits-card {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 28rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

/* 肤质详情表 */
.skin-detail-card {
  padding: 12rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.skin-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1px solid var(--color-border-light);
}

.skin-detail-row:last-child {
  border-bottom: none;
}

.skin-detail-label {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.skin-detail-value {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
}

/* 推荐妆容 */
.rec-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.rec-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease);
}

.rec-card:active {
  transform: scale(0.97);
}

.rec-cover {
  width: 100%;
  height: 160rpx;
  overflow: hidden;
}

.rec-cover image-safe {
  width: 100%;
  height: 100%;
}

.rec-info {
  padding: 14rpx;
}

.rec-title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.rec-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.rec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.rec-tag {
  padding: 2rpx 8rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: 18rpx;
}

/* 推荐产品 */
.prod-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.prod-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  position: relative;
  transition: transform var(--duration-fast) var(--ease);
}

.prod-item:active {
  transform: scale(0.98);
}

.prod-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-alt);
}

.prod-img image-safe {
  width: 100%;
  height: 100%;
}

.prod-info {
  flex: 1;
  min-width: 0;
}

.prod-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.prod-brand {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.prod-price {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.prod-arrow {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: var(--color-text-muted);
}

.bottom-placeholder {
  height: 40rpx;
}
