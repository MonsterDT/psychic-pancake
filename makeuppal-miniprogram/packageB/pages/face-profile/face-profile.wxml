<!-- packageB/pages/face-profile/face-profile.wxml -->
<view class="page-face-profile">
  <!-- 用户头像+姓名 -->
  <view class="profile-header">
    <view class="profile-avatar">
      <image-safe src="{{avatar}}" mode="aspectFill"></image-safe>
    </view>
    <view class="profile-name">{{name}}</view>
    <view class="profile-tags-row">
      <view class="profile-tag">{{faceShape}}</view>
      <view class="profile-tag">{{skinType}}</view>
      <view class="profile-tag">{{undertone}}</view>
    </view>
  </view>

  <!-- 三维评分 圆形进度条 -->
  <view class="section">
    <view class="section-title">三维评分</view>
    <view class="score-circles">
      <view class="score-circle-item" wx:for="{{scores}}" wx:key="key">
        <view class="score-circle">
          <view class="score-circle-bg"></view>
          <view class="score-circle-progress" style="background: conic-gradient({{item.color}} {{item.value * 3.6}}deg, var(--color-bg-alt) 0deg);">
            <view class="score-circle-inner">
              <text class="score-circle-val">{{item.value}}</text>
              <text class="score-circle-unit">分</text>
            </view>
          </view>
        </view>
        <view class="score-circle-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 六维数据 横向条形图 -->
  <view class="section">
    <view class="section-title">六维数据</view>
    <view class="dim-card">
      <view class="dim-row" wx:for="{{dimensions}}" wx:key="label">
        <view class="dim-label">{{item.label}}</view>
        <view class="dim-bar">
          <view class="dim-fill" style="width: {{item.width}};"></view>
        </view>
        <view class="dim-val">{{item.value}}</view>
      </view>
    </view>
  </view>

  <!-- 特征标签 -->
  <view class="section" wx:if="{{traits.length}}">
    <view class="section-title">面部特征</view>
    <view class="traits-card">
      <tag-chip wx:for="{{traits}}" wx:key="*this" text="{{item}}" type="primary"></tag-chip>
    </view>
  </view>

  <!-- 肤质详情表 -->
  <view class="section">
    <view class="section-title">肤质详情</view>
    <view class="skin-detail-card">
      <view class="skin-detail-row" wx:for="{{skinDetails}}" wx:key="label">
        <view class="skin-detail-label">{{item.label}}</view>
        <view class="skin-detail-value">{{item.value}}</view>
      </view>
    </view>
  </view>

  <!-- 推荐妆容 3张卡片 -->
  <view class="section" wx:if="{{makeupRecommendations.length}}">
    <view class="section-title">推荐妆容</view>
    <view class="rec-grid">
      <view class="rec-card" wx:for="{{makeupRecommendations}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapRecommend">
        <view class="rec-cover">
          <image-safe src="{{item.img}}" mode="aspectFill"></image-safe>
        </view>
        <view class="rec-info">
          <view class="rec-title ellipsis">{{item.title}}</view>
          <view class="rec-desc ellipsis-2">{{item.desc}}</view>
          <view class="rec-tags" wx:if="{{item.tags.length}}">
            <view class="rec-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
              <text>{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐产品列表 -->
  <view class="section" wx:if="{{productRecommendations.length}}">
    <view class="section-title">推荐产品</view>
    <view class="prod-list">
      <view class="prod-item" wx:for="{{productRecommendations}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapProduct">
        <view class="prod-img">
          <image-safe src="{{item.img}}" mode="aspectFill"></image-safe>
        </view>
        <view class="prod-info">
          <view class="prod-name ellipsis-2">{{item.name}}</view>
          <view class="prod-brand">{{item.brand}} · {{item.desc}}</view>
          <view class="prod-price">{{item.priceText}}</view>
        </view>
        <view class="prod-arrow">
          <text>›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-placeholder"></view>
</view>
