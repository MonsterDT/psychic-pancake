<!-- packageB/pages/skin-protection/skin-protection.wxml -->
<view class="page-skin-protection">
  <!-- 顶部说明 -->
  <view class="intro-card">
    <view class="intro-icon">🛡️</view>
    <view class="intro-info">
      <view class="intro-title">敏感肌保护方案</view>
      <view class="intro-desc">针对常见肌肤问题，提供分层解决方案与产品推荐</view>
    </view>
  </view>

  <!-- 问题列表 -->
  <view class="problem-list">
    <view class="problem-card" wx:for="{{problems}}" wx:key="id">
      <!-- 问题头部（点击展开） -->
      <view class="problem-head" data-id="{{item.id}}" bindtap="onToggleProblem">
        <view class="problem-head-left">
          <view class="problem-cat">{{item.category}}</view>
          <view class="problem-title">{{item.title}}</view>
          <view class="problem-meta">
            <text>{{item.solutionCount}}个方案</text>
            <text class="meta-dot">·</text>
            <text>共{{item.totalSteps}}步</text>
          </view>
        </view>
        <view class="problem-arrow {{expandedProblemId === item.id ? 'problem-arrow--open' : ''}}">
          <text>›</text>
        </view>
      </view>

      <!-- 展开内容：4层结构 问题→方案→步骤→产品 -->
      <view class="problem-body" wx:if="{{expandedProblemId === item.id}}">
        <view class="solution-block" wx:for="{{item.solutions}}" wx:for-item="sol" wx:key="id">
          <!-- 方案头部 -->
          <view class="solution-head" data-problem-id="{{item.id}}" data-solution-id="{{sol.id}}" bindtap="onToggleSolution">
            <view class="solution-head-left">
              <view class="solution-name">{{sol.name}}</view>
              <view class="solution-meta">
                <view class="solution-tag">{{sol.difficultyText}}</view>
                <view class="solution-tag" wx:if="{{sol.duration}}">⏱️ {{sol.duration}}</view>
                <view class="solution-tag" wx:if="{{sol.effect}}">✨ {{sol.effect}}</view>
                <view class="solution-tag solution-tag--hot" wx:if="{{sol.heat}}">🔥 {{sol.heat}}热度</view>
              </view>
              <view class="solution-likes">❤️ {{sol.likesText}} 觉得有用</view>
            </view>
            <view class="solution-arrow {{expandedSolutionMap[item.id + '_' + sol.id] ? 'solution-arrow--open' : ''}}">
              <text>›</text>
            </view>
          </view>

          <!-- 步骤列表 -->
          <view class="steps-block" wx:if="{{expandedSolutionMap[item.id + '_' + sol.id]}}">
            <view class="step-item" wx:for="{{sol.steps}}" wx:for-item="step" wx:key="stepNum">
              <view class="step-row" data-key="{{item.id}}_{{sol.id}}_{{step.stepNum}}" bindtap="onToggleStep">
                <view class="step-num">{{step.stepNum}}</view>
                <view class="step-desc">{{step.description}}</view>
                <view class="step-expand-icon {{expandedStepKey === item.id + '_' + sol.id + '_' + step.stepNum ? 'step-expand-icon--open' : ''}}">
                  <text>▾</text>
                </view>
              </view>
              <!-- 产品分层：高端/中端/平价 -->
              <view class="products-block" wx:if="{{expandedStepKey === item.id + '_' + sol.id + '_' + step.stepNum}}">
                <view class="product-tier" wx:for="{{step.products}}" wx:for-item="prod" wx:key="tier">
                  <view class="product-tier-head">
                    <view class="tier-badge tier-badge--{{prod.tier === '高端' ? 'high' : (prod.tier === '中端' ? 'mid' : 'low')}}">{{prod.tier}}</view>
                    <view class="product-brand">{{prod.brand}}</view>
                  </view>
                  <view class="product-name">{{prod.name}}</view>
                  <view class="product-meta">
                    <text class="product-price">¥{{prod.price}}</text>
                    <text class="product-rating">⭐ {{prod.rating}}</text>
                  </view>
                </view>
              </view>
            </view>

            <!-- 注意事项 -->
            <view class="warnings-block" wx:if="{{sol.warnings.length}}">
              <view class="warnings-title">⚠️ 注意事项</view>
              <view class="warning-item" wx:for="{{sol.warnings}}" wx:for-item="warn" wx:key="index">
                <view class="warning-title" wx:if="{{warn.title}}">{{warn.title}}</view>
                <view class="warning-desc" wx:if="{{warn.desc}}">{{warn.desc}}</view>
                <view class="warning-source" wx:if="{{warn.source}}">— {{warn.source}}</view>
                <view class="warning-tip" wx:if="{{warn.tip}}">💡 {{warn.tip}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-placeholder"></view>
</view>
