/* packageB/pages/skin-protection/skin-protection.wxss */
.page-skin-protection {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 顶部说明 */
.intro-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(196, 149, 106, 0.25);
}

.intro-icon {
  font-size: 64rpx;
}

.intro-info {
  flex: 1;
}

.intro-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 8rpx;
}

.intro-desc {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
}

/* 问题列表 */
.problem-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.problem-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.problem-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  transition: background var(--duration-fast) var(--ease);
}

.problem-head:active {
  background: var(--color-bg-alt);
}

.problem-head-left {
  flex: 1;
  min-width: 0;
}

.problem-cat {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  margin-bottom: 12rpx;
}

.problem-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.problem-meta {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.meta-dot {
  margin: 0 8rpx;
}

.problem-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--color-text-muted);
  line-height: 1;
  transform: rotate(90deg);
  transition: transform var(--duration-normal) var(--ease);
  margin-left: 16rpx;
}

.problem-arrow--open {
  transform: rotate(-90deg);
}

/* 展开内容 */
.problem-body {
  padding: 0 32rpx 28rpx;
  border-top: 1px solid var(--color-border-light);
}

.solution-block {
  padding: 24rpx 0;
  border-bottom: 1px solid var(--color-border-light);
}

.solution-block:last-child {
  border-bottom: none;
}

.solution-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.solution-head-left {
  flex: 1;
  min-width: 0;
}

.solution-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.solution-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.solution-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.solution-tag--hot {
  background: rgba(196, 92, 92, 0.1);
  color: var(--color-danger);
}

.solution-likes {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.solution-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: var(--color-text-muted);
  line-height: 1;
  transform: rotate(90deg);
  transition: transform var(--duration-normal) var(--ease);
}

.solution-arrow--open {
  transform: rotate(-90deg);
}

/* 步骤列表 */
.steps-block {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.step-item {
  margin-bottom: 16rpx;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
}

.step-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-desc {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text);
  line-height: 1.6;
  padding-top: 6rpx;
}

.step-expand-icon {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 6rpx;
  transition: transform var(--duration-normal) var(--ease);
}

.step-expand-icon--open {
  transform: rotate(180deg);
}

/* 产品分层 */
.products-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
  padding-left: 56rpx;
}

.product-tier {
  padding: 14rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
  border-left: 6rpx solid var(--color-primary);
}

.product-tier-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.tier-badge {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
}

.tier-badge--high {
  background: rgba(196, 92, 92, 0.1);
  color: var(--color-danger);
}

.tier-badge--mid {
  background: rgba(196, 149, 106, 0.15);
  color: var(--color-primary);
}

.tier-badge--low {
  background: rgba(107, 158, 107, 0.1);
  color: var(--color-success);
}

.product-brand {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.product-name {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
  margin-bottom: 6rpx;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-price {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.product-rating {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 注意事项 */
.warnings-block {
  margin-top: 20rpx;
  padding: 16rpx;
  background: rgba(212, 160, 60, 0.08);
  border-radius: var(--radius-md);
}

.warnings-title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-warning);
  margin-bottom: 12rpx;
}

.warning-item {
  padding: 8rpx 0;
}

.warning-title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.warning-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 4rpx;
}

.warning-source {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}

.warning-tip {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  line-height: 1.6;
}

.bottom-placeholder {
  height: 40rpx;
}
