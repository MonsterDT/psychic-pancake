/* packageB/pages/report-detail/report-detail.wxss */
.page-report-detail {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 报告头部 */
.report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(196, 149, 106, 0.25);
}

.report-meta {
  flex: 1;
}

.report-type {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: #fff;
  margin-bottom: 8rpx;
}

.report-date {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
}

.report-total {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-direction: column;
  align-items: flex-end;
}

.report-total-num {
  font-size: 72rpx;
  font-weight: var(--font-weight-bold);
  color: #fff;
  line-height: 1;
}

.report-total-unit {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
  margin-top: -8rpx;
}

.report-total-level {
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: var(--font-size-xs);
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* 雷达图卡片 */
.radar-card {
  padding: 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.radar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.radar-svg {
  position: relative;
  width: 400rpx;
  height: 400rpx;
}

/* 背景同心三角（用 border 模拟） */
.radar-bg-tri {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  transform: translate(-50%, -50%);
}

.radar-bg-1 {
  border-left: 76rpx solid transparent;
  border-right: 76rpx solid transparent;
  border-bottom: 132rpx solid rgba(196, 149, 106, 0.08);
  transform: translate(-50%, -55%) rotate(0deg);
}

.radar-bg-2 {
  border-left: 57rpx solid transparent;
  border-right: 57rpx solid transparent;
  border-bottom: 99rpx solid rgba(196, 149, 106, 0.12);
  transform: translate(-50%, -55%) rotate(0deg);
}

.radar-bg-3 {
  border-left: 38rpx solid transparent;
  border-right: 38rpx solid transparent;
  border-bottom: 66rpx solid rgba(196, 149, 106, 0.18);
  transform: translate(-50%, -55%) rotate(0deg);
}

/* 数据三角填充 */
.radar-data-tri {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(196, 149, 106, 0.45), rgba(212, 184, 150, 0.55));
  clip-path: polygon(50% 12%, 12% 88%, 88% 88%);
}

/* 数据点 */
.radar-point {
  position: absolute;
  width: 0;
  height: 0;
  transform: translate(-50%, -50%);
}

.radar-point-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(196, 149, 106, 0.4);
}

/* 标签 */
.radar-label {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
  background: var(--color-bg-card);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xs);
}

.radar-label-name {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.radar-label-val {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

/* 三项分数列表 */
.score-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-row-name {
  width: 80rpx;
  font-size: var(--font-size-base);
  color: var(--color-text);
  flex-shrink: 0;
}

.score-row-bar {
  flex: 1;
  height: 16rpx;
  background: var(--color-bg-alt);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.score-row-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-full);
}

.score-row-val {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 六维数据条形图 */
.dim-card {
  padding: 28rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.dim-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.dim-label {
  width: 160rpx;
  font-size: var(--font-size-base);
  color: var(--color-text);
  flex-shrink: 0;
}

.dim-bar {
  flex: 1;
  height: 20rpx;
  background: var(--color-bg-alt);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent), var(--color-primary));
  border-radius: var(--radius-full);
  transition: width var(--duration-slow) var(--ease);
}

.dim-val {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 分析卡片 */
.analysis-card {
  padding: 28rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.analysis-item {
  padding: 16rpx 0;
}

.analysis-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.analysis-icon {
  font-size: 32rpx;
}

.analysis-name {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.analysis-value {
  margin-left: auto;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.analysis-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.analysis-divider {
  height: 1px;
  background: var(--color-border-light);
  margin: 4rpx 0;
}

/* 推荐妆容 */
.rec-scroll {
  width: 100%;
  white-space: nowrap;
}

.rec-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx;
}

.rec-card {
  display: inline-block;
  width: 280rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease);
}

.rec-card:active {
  transform: scale(0.97);
}

.rec-cover {
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.rec-cover-img {
  width: 100%;
  height: 100%;
}

.rec-info {
  padding: 16rpx;
  white-space: normal;
}

.rec-title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.rec-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.rec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.rec-tag {
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
}

.bottom-placeholder {
  height: 40rpx;
}
