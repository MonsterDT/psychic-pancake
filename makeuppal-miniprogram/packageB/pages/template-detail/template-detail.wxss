/* packageB/pages/template-detail/template-detail.wxss */
.page-template-detail {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 80px;
}

/* 顶部大图 */
.hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
  pointer-events: none;
}

.hero-tags {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 标题信息区 */
.info-card {
  margin: -40rpx 24rpx 0;
  padding: 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 2;
}

.info-title {
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.info-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.info-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  background: var(--color-bg-alt);
}

.info-avatar image-safe {
  width: 100%;
  height: 100%;
}

.info-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  color: var(--color-primary);
}

.info-author-name {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: var(--font-weight-medium);
}

.info-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.info-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.info-stat-icon {
  font-size: 24rpx;
}

.info-stat-num {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 区块 */
.section {
  margin: 32rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.section-count {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* 步骤列表 */
.steps {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--color-border-light);
}

.step-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-item:first-child {
  padding-top: 0;
}

.step-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.step-products {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 8rpx;
}

.step-products-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 40rpx;
}

.step-product-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.step-product-chip {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
}

.bottom-placeholder {
  height: 40rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom, 0px));
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(45, 42, 38, 0.08);
}

.action-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  min-width: 80rpx;
  background: transparent;
  border: none;
  line-height: 1.2;
}

.action-icon-btn::after {
  border: none;
}

.action-icon-btn--active .action-icon-text {
  color: var(--color-primary);
}

.action-share-btn {
  font-size: inherit;
  font-family: inherit;
}

.action-icon {
  font-size: 36rpx;
}

.action-icon-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.action-try-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(196, 149, 106, 0.3);
}

.action-try-btn:active {
  opacity: 0.85;
}
