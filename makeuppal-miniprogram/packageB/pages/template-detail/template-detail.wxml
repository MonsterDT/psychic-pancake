<!-- packageB/pages/template-detail/template-detail.wxml -->
<view class="page-template-detail">
  <!-- 顶部大图 -->
  <view class="hero">
    <image-safe src="{{coverImage}}" mode="aspectFill" class="hero-image" bind:tap="onPreviewImage"></image-safe>
    <view class="hero-mask"></view>
    <view class="hero-tags" wx:if="{{tags.length}}">
      <tag-chip wx:for="{{tags}}" wx:key="*this" text="{{item}}" type="primary" size="sm"></tag-chip>
    </view>
  </view>

  <!-- 标题信息区 -->
  <view class="info-card">
    <view class="info-title">{{title}}</view>
    <view class="info-desc" wx:if="{{desc}}">{{desc}}</view>
    <view class="info-meta">
      <view class="info-author" wx:if="{{author}}">
        <view class="info-avatar" wx:if="{{avatar}}">
          <image-safe src="{{avatar}}" mode="aspectFill"></image-safe>
        </view>
        <view class="info-avatar info-avatar--placeholder" wx:else>
          <text>{{author}}</text>
        </view>
        <text class="info-author-name">{{author}}</text>
      </view>
      <view class="info-stats">
        <view class="info-stat">
          <text class="info-stat-icon">❤️</text>
          <text class="info-stat-num">{{likesText}}</text>
        </view>
        <view class="info-stat" wx:if="{{occasion}}">
          <text class="info-stat-icon">🎯</text>
          <text class="info-stat-num">{{occasion}}</text>
        </view>
        <view class="info-stat">
          <text class="info-stat-icon">⚡</text>
          <text class="info-stat-num">{{difficultyText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤拆解 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">步骤拆解</text>
      <text class="section-count">共{{steps.length}}步</text>
    </view>
    <view class="steps">
      <view class="step-item" wx:for="{{steps}}" wx:key="num">
        <view class="step-num">{{item.num}}</view>
        <view class="step-content">
          <view class="step-title">{{item.title}}</view>
          <view class="step-desc">{{item.desc}}</view>
          <view class="step-products" wx:if="{{item.products.length}}">
            <text class="step-products-label">推荐产品：</text>
            <view class="step-product-chips">
              <view class="step-product-chip" wx:for="{{item.products}}" wx:for-item="prod" wx:key="*this">
                <text>{{prod}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 占位高度，避免被底部操作栏遮挡 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar safe-bottom">
    <view class="action-icon-btn {{hasLiked ? 'action-icon-btn--active' : ''}}" bindtap="onLike">
      <text class="action-icon">{{hasLiked ? '❤️' : '🤍'}}</text>
      <text class="action-icon-text">喜欢</text>
    </view>
    <view class="action-icon-btn {{isFavorite ? 'action-icon-btn--active' : ''}}" bindtap="onFavorite">
      <text class="action-icon">{{isFavorite ? '⭐' : '☆'}}</text>
      <text class="action-icon-text">收藏</text>
    </view>
    <button class="action-icon-btn action-share-btn" open-type="share">
      <text class="action-icon">📤</text>
      <text class="action-icon-text">分享</text>
    </button>
    <view class="action-try-btn" bindtap="onTryNow">
      <text>立即试用</text>
    </view>
  </view>
</view>
