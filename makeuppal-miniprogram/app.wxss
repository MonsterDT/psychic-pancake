/* app.wxss - 全局样式 */

/* ===== CSS 变量（从 :root 迁移到 page）===== */
page {
  /* 颜色 */
  --color-bg: #FFF8F0;
  --color-bg-alt: #FFF1E6;
  --color-bg-card: #FFFFFF;
  --color-primary: #C4956A;
  --color-primary-light: #D4B896;
  --color-primary-dark: #A67B52;
  --color-accent: #E8C9A8;
  --color-text: #2D2A26;
  --color-text-secondary: #6B6560;
  --color-text-muted: #9B9590;
  --color-border: #E8DDD2;
  --color-border-light: #F5EDE4;
  --color-hero-bg: #1A1816;
  --color-hero-text: #FFF8F0;
  --color-code-bg: #F5EDE4;
  --color-success: #6B9E6B;
  --color-warning: #D4A03C;
  --color-danger: #C45C5C;
  --color-info: #5B8EC4;

  /* 字体 */
  --font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --font-serif: 'PingFang SC', 'Microsoft YaHei', serif;

  /* 圆角 */
  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;

  /* 阴影 */
  --shadow-xs: 0 1px 2px rgba(45,42,38,0.04);
  --shadow-sm: 0 1px 3px rgba(45,42,38,0.08);
  --shadow-md: 0 4px 12px rgba(45,42,38,0.1);
  --shadow-lg: 0 8px 30px rgba(45,42,38,0.12);

  /* 字号 */
  --font-size-xs: 10px;
  --font-size-sm: 12px;
  --font-size-base: 14px;
  --font-size-md: 15px;
  --font-size-lg: 16px;
  --font-size-xl: 18px;
  --font-size-2xl: 22px;
  --font-size-3xl: 28px;

  /* 字重 */
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* 间距 */
  --spacing-2: 8px;
  --spacing-3: 12px;
  --spacing-4: 16px;
  --spacing-5: 20px;
  --spacing-6: 24px;
  --spacing-8: 32px;
  --spacing-10: 40px;

  /* 布局尺寸 */
  --tab-bar-height: 56px;
  --header-height: 48px;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-top: env(safe-area-inset-top, 0px);

  /* 最大宽度 */
  --content-max-width: 100%;

  /* z-index 层级 */
  --z-tab: 100;
  --z-sheet: 200;
  --z-modal: 300;
  --z-toast: 400;

  /* 动效 */
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 400ms;

  /* 基础样式 */
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-sans);
  font-size: var(--font-size-base);
  line-height: 1.5;
}

/* ===== 全局重置 ===== */
view, text, image, scroll-view, swiper, input, textarea, button, navigator {
  box-sizing: border-box;
}

image {
  display: block;
}

/* ===== 通用原子类 ===== */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-around { display: flex; align-items: center; justify-content: space-around; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

.text-center { text-align: center; }
.text-right { text-align: right; }
.text-muted { color: var(--color-text-muted); }
.text-secondary { color: var(--color-text-secondary); }
.text-primary { color: var(--color-primary); }
.text-danger { color: var(--color-danger); }
.text-success { color: var(--color-success); }

.font-bold { font-weight: var(--font-weight-bold); }
.font-semibold { font-weight: var(--font-weight-semibold); }
.font-medium { font-weight: var(--font-weight-medium); }

.text-xs { font-size: var(--font-size-xs); }
.text-sm { font-size: var(--font-size-sm); }
.text-base { font-size: var(--font-size-base); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }
.text-2xl { font-size: var(--font-size-2xl); }

/* ===== 卡片基础样式 ===== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* ===== 按钮基础样式 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  transition: all var(--duration-fast) var(--ease);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 4px 12px rgba(196, 149, 106, 0.3);
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
}

.btn-block {
  width: 100%;
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-height) + var(--safe-bottom) + 10px);
}

/* ===== 文本省略 ===== */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== 毛玻璃效果（backdrop-filter降级方案）===== */
.glass {
  background: rgba(255, 248, 240, 0.85);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
}

/* ===== 占位页样式 ===== */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: var(--spacing-8);
  text-align: center;
}

.placeholder-title {
  font-size: 32px;
  margin-bottom: var(--spacing-4);
}

.placeholder-desc {
  font-size: var(--font-size-lg);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-2);
}

.placeholder-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-4) var(--spacing-4) var(--spacing-2);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.section-more {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* ===== 列表项 ===== */
.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-4);
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border-light);
}

.list-item:last-child {
  border-bottom: none;
}

/* ===== 网格布局 ===== */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-3);
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--spacing-3);
}

.grid-4 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: var(--spacing-2);
}

.grid-5 {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--spacing-2);
}

/* ===== 安全区域工具类 ===== */
.safe-top { padding-top: var(--safe-top); }
.safe-bottom { padding-bottom: var(--safe-bottom); }
.safe-area { padding-top: var(--safe-top); padding-bottom: var(--safe-bottom); }

/* ===== 水平滚动 ===== */
.scroll-x {
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.scroll-x::-webkit-scrollbar {
  display: none;
}

/* ===== 分隔符 ===== */
.divider {
  height: 1px;
  background: var(--color-border-light);
  margin: var(--spacing-3) 0;
}

.divider-thick {
  height: 8px;
  background: var(--color-bg-alt);
}

/* ===== 标签 ===== */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  background: var(--color-bg-alt);
  color: var(--color-text-secondary);
}

.chip-primary {
  background: rgba(196, 149, 106, 0.1);
  color: var(--color-primary);
}

.chip-danger {
  background: rgba(196, 92, 92, 0.1);
  color: var(--color-danger);
}

/* ===== 徽章 ===== */
.badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: var(--radius-full);
  background: var(--color-danger);
  color: #fff;
  font-size: var(--font-size-xs);
  line-height: 18px;
  text-align: center;
}

/* ===== 水平间距 ===== */
.px-4 { padding-left: var(--spacing-4); padding-right: var(--spacing-4); }
.py-4 { padding-top: var(--spacing-4); padding-bottom: var(--spacing-4); }
.p-4 { padding: var(--spacing-4); }
.mt-2 { margin-top: var(--spacing-2); }
.mt-4 { margin-top: var(--spacing-4); }
.mb-2 { margin-bottom: var(--spacing-2); }
.mb-4 { margin-bottom: var(--spacing-4); }

/* ===== 底部固定栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(var(--tab-bar-height) + var(--safe-bottom));
  z-index: var(--z-sheet);
  background: var(--color-bg-card);
  box-shadow: 0 -2px 10px rgba(45, 42, 38, 0.06);
  padding: var(--spacing-3) var(--spacing-4);
}

/* ===== 顶部固定栏 ===== */
.sticky-top {
  position: sticky;
  top: 0;
  z-index: var(--z-tab);
  background: var(--color-bg);
}

/* ===== 输入框 ===== */
.input {
  width: 100%;
  padding: 10px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background: var(--color-bg-card);
  color: var(--color-text);
}

.input:focus {
  border-color: var(--color-primary);
}

/* ===== 头像 ===== */
.avatar {
  border-radius: var(--radius-full);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-sm { width: 32px; height: 32px; }
.avatar-md { width: 48px; height: 48px; }
.avatar-lg { width: 64px; height: 64px; }
.avatar-xl { width: 80px; height: 80px; }
